*.tauri-private.key
*.key.pub.bak
.tauri/

# Secrets
.env
.env.*
!.env.example

# Model weights. Downloaded at runtime into the OS app-data directory,
# never into the repo. Listed so a stray copy can't be committed.
*.onnx
*.onnx.data
models/

# User data. A dictation app must never ship someone's transcripts or audio.
*.db
*.db-journal
*.sqlite
*.sqlite3
transcripts.db
recordings/
inkwell_debug*.wav
# Add sound assets with `git add -f` if any are ever bundled.
*.wav

