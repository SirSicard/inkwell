# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
build
*.local

# Rust build artifacts
target/
src-tauri/target/

# Tauri generated + signing material (NEVER commit)
src-tauri/gen/
