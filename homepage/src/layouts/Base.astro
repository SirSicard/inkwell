---
// The document shell: head metadata, icons, the social card, and two pre-paint flags: `js`, and the
// theme the visitor picked (light or dark; none follows the system). Every page goes through it.
import '../styles/base.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { SITE_URL } from '../lib/constants';

interface Props {
  title: string;
  description: string;
  /** Path of the canonical URL, e.g. "/". Omitted on pages that must not be indexed. */
  canonicalPath?: string;
  noindex?: boolean;
  /** JSON-LD objects, serialised into one script tag. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonicalPath, noindex = false, jsonLd } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, SITE_URL).href : undefined;
// A new file name for 1.0, so X, Slack and WhatsApp fetch it instead of their cached og.png.
const ogImage = new URL('/og-1.0.png', SITE_URL).href;
const ogAlt = 'Inkwell: dictation and meeting notes that stay on your machine. The Glow orb in indigo and coral on a near-black ground.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before the first paint: the `js` flag, and the visitor's theme, if they picked one (stored in
         this browser only; a blocked store just follows the system). */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('inkwell-theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="application-name" content="Inkwell" />
    {/* One theme colour for both schemes: the browser's bar always meets the dark hero first. */}
    <meta name="theme-color" content="#0b0a0f" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Inkwell" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <slot />
  </body>
</html>
