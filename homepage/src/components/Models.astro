---
// The models, one per job. The ink stays the voice (it only appears in the hero); this is a plain table.
import { MODEL_WEIGHTS_URL, MODELS } from '../lib/constants';
---

<section class="models wrap" id="models" aria-labelledby="models-title">
  <div class="section-head">
    <h2 id="models-title">One model per job, chosen by measurement.</h2>
    <p class="section-intro">
      Each was picked by measuring word error rates on public, human-labelled recordings: meetings from the
      AMI corpus and FLEURS English. None ships inside the installer: each downloads the first time it is
      needed, from a pinned revision, and after that needs no internet.
    </p>
  </div>

  <table class="model-table" role="table">
    <caption class="sr-only">The speech models in Inkwell, one per job.</caption>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">Model</th>
        <th scope="col" role="columnheader">Its job</th>
        <th scope="col" role="columnheader">Runs on</th>
        <th scope="col" role="columnheader">Download</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        MODELS.map((m) => (
          <tr role="row">
            <th scope="row" role="rowheader" class="c-name">
              <span class="model-name">{m.name}</span>
              <span class="model-maker">{m.maker}</span>
            </th>
            <td role="cell" class="c-when">{m.job}</td>
            <td role="cell" class="c-langs">
              <span class="m-only">Runs on </span>
              {m.runsOn}
            </td>
            <td role="cell" class="c-size num">
              {m.size ?? 'Per platform'}<span class="m-only"> download</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="footnote">
    Whisper, SenseVoice and MLX builds were measured too, and are not used. Every model’s licence is in
    <a href={MODEL_WEIGHTS_URL}>the model list</a>.
  </p>
</section>
