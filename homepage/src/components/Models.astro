---
// Modes, the language models and the speech models: the README's "Modes", "Language models
// (optional)", "A free Groq key" and "Models", and docs/MODEL-WEIGHTS.md. A plain list, no
// accuracy figures: 1.0 publishes none.
import Shot from './Shot.astro';
import { GROQ_KEYS_URL, GROQ_RATE_LIMITS_URL, MODEL_WEIGHTS_URL, MODELS } from '../lib/constants';
---

<section class="section" id="models" aria-labelledby="models-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="models-title">Modes, and the models underneath.</h2>
      <p>
        A mode bundles a style, filler removal and polish (its own instructions, and optionally its own language
        model), and switches on by the app you are typing in. Edited in Settings > Modes.
      </p>
    </div>

    <div class="split">
      <div>
        <h3 id="language-models" class="sub">Language models, optional</h3>
        <p class="muted sub-lede">
          Transcripts never need one. Polish, voice editing, summaries, commitments and Ask do. Three ways to get one:
        </p>
      </div>
      <Shot shot="p2" optional sizes="(min-width: 60rem) 34rem, 100vw" />
    </div>

    <div class="options">
      <div>
        <h3>Apple’s on-device model</h3>
        <p class="where">Mac</p>
        <p>With Apple Intelligence on, Apple’s Foundation Models: no download, no key, and your words stay on the Mac.</p>
      </div>
      <div>
        <h3>Qwen3-4B on this PC</h3>
        <p class="where">Windows</p>
        <p>
          Qwen3-4B-Instruct-2507, 2.5 GB, downloaded when you ask. It runs in Inkwell on the GPU or the CPU, so Local
          only stays on and no key is needed.
        </p>
      </div>
      <div>
        <h3>Your own key</h3>
        <p class="where">Both</p>
        <p>
          OpenAI, Groq, Anthropic, OpenRouter or any OpenAI-compatible server, used before the on-device model.
          Agreeing to send to one off this machine turns Local only off, and each feature asks before it sends.
        </p>
      </div>
    </div>

    <details class="more">
      <summary>A free Groq key</summary>
      <div class="more-body">
        <p>
          Groq’s Free plan costs $0 and has rate limits, listed on its <a href={GROQ_RATE_LIMITS_URL}>Rate Limits page</a>.
          The app’s guide (Settings > AI, “How to get a free Groq key”) has the same steps:
        </p>
        <ol>
          <li>Open Groq’s API Keys page: <a href={GROQ_KEYS_URL}>console.groq.com/keys</a>.</li>
          <li>Log in, or make a Groq account.</li>
          <li>Press <b>Create API Key</b> and give the key a name, such as Inkwell.</li>
          <li>Copy the key. In Inkwell’s Settings > AI, choose Groq, paste it and press <b>Save key</b>, then <b>Use Groq</b>.</li>
        </ol>
      </div>
    </details>

    <details class="more wide-open models-more">
      <summary>What runs on your machine <span class="hint">Five models, each downloaded when first needed</span></summary>
      <div class="more-body">
    <ul class="model-list">
      {MODELS.map((m) => (
        <li>
          <span class="name">{m.name}</span>
          <span class="size">{m.size}</span>
          <span class="job">{m.job}</span>
          <span class="lic">{m.licence}</span>
        </li>
      ))}
    </ul>
    <p class="footnote">
      Downloaded when first needed, from a pinned revision with a checked hash. Chosen by measuring word error rate on
      AMI meetings and FLEURS English: 1.0 targets English. <a href={MODEL_WEIGHTS_URL}>Credits and policy</a>.
    </p>
      </div>
    </details>
  </div>
</section>
