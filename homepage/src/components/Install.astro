---
// Download and first run, from the README's Install, Quick start and Requirements sections (the default
// keys were checked against ink-ffi's voice.rs, the Windows minimum against windows/Inkwell.csproj). The
// file links are the releases' real assets (see ../lib/release.ts). The Mac build is signed and
// notarised; the Windows build is not signed yet.
import { BUILD_FROM_SOURCE_URL, RELEASES_URL, SHARED_VERSION } from '../lib/constants';
import { DOWNLOADS } from '../lib/release';
---

<section class="install wrap" id="download" aria-labelledby="download-title">
  <div class="section-head">
    <h2 id="download-title">Download Inkwell{SHARED_VERSION && ` ${SHARED_VERSION}`}.</h2>
    <p class="section-intro">
      Free, with no account and no email address asked for. Every build is also on the
      <a href={RELEASES_URL}>GitHub releases page</a>, and you can <a href={BUILD_FROM_SOURCE_URL}>build it from
      source</a>. Linux and Intel Macs aren’t supported: Inkwell 0.2 stays the last version for them, on the
      same page.
    </p>
  </div>

  <div class="platforms">
    <div class="platform" data-platform="macOS">
      <div class="platform-head">
        <h3>macOS</h3>
        <p class="detected-note" hidden>This computer</p>
        <p>Apple silicon, on macOS 26 or later.</p>
        <ul class="files">
          <li><a href={DOWNLOADS.macOS.url} translate="no">{DOWNLOADS.macOS.name}</a> <span>{DOWNLOADS.macOS.size}</span></li>
        </ul>
      </div>
      <div class="platform-body">
        <ol class="steps">
          <li>
            Open the disk image, drag Inkwell to Applications and open it. It is signed with a Developer ID and
            notarised by Apple, so there is no warning to click past.
          </li>
          <li>Allow Microphone access when asked.</li>
          <li>
            Allow Accessibility access in System Settings, under Privacy &amp; Security. Inkwell needs it to hear
            the dictation key and to type the text; until you grant it, dictation stays off and says why.
          </li>
          <li>For meetings, allow System Audio Recording when asked: it is how Inkwell hears the other side of a call.</li>
          <li>Calendars is optional: it lets Inkwell show your next meeting and name each meeting and who was in it.</li>
        </ol>
        <p class="platform-note">
          Secure Input (a password field, some terminals) blocks typing into that app: nothing is typed, and
          Inkwell says so.
        </p>
      </div>
    </div>

    <div class="platform" data-platform="Windows" id="windows-install">
      <div class="platform-head">
        <h3>Windows</h3>
        <p class="detected-note" hidden>This computer</p>
        <p>Windows 11 24H2 or later, on x64{DOWNLOADS.windowsArm64 && ' or ARM64'}.</p>
        <ul class="files">
          <li><a href={DOWNLOADS.windows.url} translate="no">{DOWNLOADS.windows.name}</a> <span>{DOWNLOADS.windows.size}</span></li>
          {DOWNLOADS.windowsArm64 && (
            <li><a href={DOWNLOADS.windowsArm64.url} translate="no">{DOWNLOADS.windowsArm64.name}</a> <span>{DOWNLOADS.windowsArm64.size}</span></li>
          )}
        </ul>
      </div>
      <div class="platform-body">
        {/* PLACEHOLDER: the guide to installing without a signature. The Windows distribution step (S3.6)
            drafts its final wording; the README's Install section and the hero link here. */}
        <ol class="steps">
          <li>
            Download the installer for your PC{DOWNLOADS.windowsArm64 && ', x64 or ARM64'}. If your browser says the
            file isn’t commonly downloaded, choose to keep it.
          </li>
          <li>
            Run it. The installer is not code signed yet, so SmartScreen says “Windows protected your PC”: click
            “More info”, then “Run anyway”.
          </li>
        </ol>
        <p class="platform-note">
          Windows warns about any installer without a signature, and Inkwell’s isn’t signed yet. The source and
          the workflow that built this file are public, so you can check what you are running.
        </p>
      </div>
    </div>
  </div>

  <div class="install-after">
    <div>
      <h3>First run</h3>
      <ol class="steps">
        <li>
          Finish the onboarding. The installer holds no speech models: Inkwell downloads them the first time
          they are needed, the main one about 2.5&nbsp;GB.
        </li>
        <li>
          The dictation key starts as <kbd>Fn</kbd> on the Mac and right <kbd>Ctrl</kbd> on Windows. Change it in
          Settings.
        </li>
        <li>Hold the key, speak, let go. The text is typed where your cursor is.</li>
      </ol>
    </div>
    <div>
      <h3>Requirements</h3>
      <dl class="reqs">
        <div><dt>System</dt><dd>A Mac with Apple silicon on macOS 26 or later, or a PC with Windows 11 24H2 or later on x64{DOWNLOADS.windowsArm64 && ' or ARM64'}</dd></div>
        <div><dt>Disk</dt><dd>About 2.5&nbsp;GB for the main speech model, plus the meetings you keep</dd></div>
        <div><dt>Microphone</dt><dd>Any</dd></div>
      </dl>
    </div>
  </div>
</section>
