---
// The hero, always dark: the headline, the product right under it, and the download block. Behind
// it, one canvas draws the app's orb (src/lib/glow-orb.ts), wandering slowly as it does behind the
// app's main window; over it, a coded dictation (src/lib/hero.ts): the key goes down, the Drop
// shows the live words with its orb live, the key comes up and the final text is typed. Without JS,
// or under reduced motion, it is one still frame of that moment.
import SiteHeader from './SiteHeader.astro';
import Downloads from './Downloads.astro';
import { PRESETS } from '../data/glow';
import { DEMO_LINES } from '../lib/demo-lines';
---

<section class="hero band-dark" aria-labelledby="hero-title" data-hero>
  <div class="orb-fallback" aria-hidden="true"></div>
  <canvas class="orb-canvas" data-orb aria-hidden="true"></canvas>
  <SiteHeader />
  <div class="hero-inner wrap">
    <h1 id="hero-title">Dictation and meeting notes that stay on&nbsp;your&nbsp;machine.</h1>
    <p class="lead">
      Hold a key, speak, let go: the text lands where you were typing. In a meeting, you and the other side are
      recorded as two streams and transcribed on your own Mac or PC.
    </p>

    <figure class="stage" data-demo>
      <div class="note" aria-hidden="true">
        <div class="note-bar"><b>New message</b><span>To: the team</span></div>
        <p class="note-body"><span class="before">Hi all, </span><span data-field></span><span class="caret"></span></p>
      </div>
      <div class="stage-row" aria-hidden="true">
        <div class="keys is-down" data-keys><kbd>⌃</kbd><kbd>⇧</kbd><kbd class="is-wide">Space</kbd></div>
        <div class="drop" data-drop>
          <span class="drop-orb" data-drop-orb></span>
          <span class="drop-words" data-drop-words>{DEMO_LINES[0].live}</span>
          <span class="drop-rec"><span>●</span>&nbsp;REC</span>
        </div>
      </div>
      <figcaption class="sr-only">
        An animation of a dictation: a shortcut is held, the Drop, Inkwell’s small recording light, shows the
        words as they are heard, and when the keys come up the finished sentence is typed into a message.
      </figcaption>
      <div class="presets js-only">
        <span id="presets-label">Dot colours</span>
        <ul aria-labelledby="presets-label">
          {PRESETS.map((p, i) => (
            <li>
              <button type="button" data-preset={p.id} aria-pressed={i === 0 ? 'true' : 'false'} title={p.name} aria-label={p.name} style={`--a:${p.you};--b:${p.them}`}>
                <span></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </figure>

    <Downloads id="get" />
  </div>
</section>
