---
import {
  APP_VERSION,
  AUTHOR_NAME,
  AUTHOR_URL,
  BUILD_FROM_SOURCE_URL,
  CONTRIBUTING_URL,
  GITHUB_URL,
  HANDY_URL,
  ISSUES_URL,
  LICENSE_URL,
  RELEASES_URL,
  SECURITY_URL,
  SHERPA_ONNX_URL,
  SILERO_VAD_URL,
  TAURI_URL,
} from '../lib/constants';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
---

<footer class="colophon" aria-labelledby="colophon-title">
  <div class="wrap colophon-grid">
    <div class="colophon-text">
      <h2 id="colophon-title" class="sr-only">Colophon</h2>
      <p>
        <span translate="no">Inkwell</span> {APP_VERSION} is free and MIT licensed, built by
        <a href={AUTHOR_URL}>{AUTHOR_NAME}</a>. Originally based on <a href={HANDY_URL}>Handy</a> by CJ Pais.
        Speech recognition by <a href={SHERPA_ONNX_URL} style="white-space: nowrap">sherpa-onnx</a>, silence detection by
        <a href={SILERO_VAD_URL}>Silero VAD</a>, desktop shell by <a href={TAURI_URL}>Tauri</a>.
      </p>
      <p>
        The app is Rust and Tauri v2, with sherpa-onnx on ONNX Runtime (CPU) for inference, cpal for capture,
        rubato for resampling and SQLite for history. Its front end is React 19, TypeScript, Tailwind v4,
        Framer Motion and a WebGL ink shader, which this page borrows.
      </p>
      <p>This site sets no cookies and runs no analytics.</p>
    </div>
    <ul class="colophon-links" aria-label="Project links">
      <li><a href={GITHUB_URL}>GitHub</a></li>
      <li><a href={RELEASES_URL}>All releases</a></li>
      <li><a href={ISSUES_URL}>Issues</a></li>
      <li><a href={BUILD_FROM_SOURCE_URL}>Build from source</a></li>
      <li><a href={CONTRIBUTING_URL}>Contributing</a></li>
      <li><a href={SECURITY_URL}>Security</a></li>
      <li><a href={LICENSE_URL}>MIT licence</a></li>
      <li><a href={`${base}#privacy`}>Privacy</a></li>
      <li><a href={`${base}#code-signing`}>Code signing</a></li>
    </ul>
  </div>
</footer>
