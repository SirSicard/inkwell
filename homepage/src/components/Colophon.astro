---
import {
  APP_VERSION,
  AUTHOR_NAME,
  AUTHOR_URL,
  BUILD_FROM_SOURCE_URL,
  CONTRIBUTING_URL,
  CREDITS,
  GITHUB_URL,
  HANDY_URL,
  ISSUES_URL,
  LEGACY_BRANCH_URL,
  LICENSE_URL,
  RELEASES_URL,
  SECURITY_URL,
  THIRD_PARTY_URL,
} from '../lib/constants';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
---

<footer class="colophon" aria-labelledby="colophon-title">
  <div class="wrap colophon-grid">
    <div class="colophon-text">
      <h2 id="colophon-title" class="sr-only">Colophon</h2>
      <p>
        <span translate="no">Inkwell</span> {APP_VERSION} is free and MIT licensed, built by
        <a href={AUTHOR_URL}>{AUTHOR_NAME}</a>. It is a native app on each platform over one Rust core: SwiftUI and
        AppKit on the Mac, WinUI 3 on Windows.
      </p>
      <p>
        It runs on {CREDITS.map((c, i) => (
          <>{i > 0 && (i === CREDITS.length - 1 ? ' and ' : ', ')}<a href={c.url}>{c.name}</a></>
        ))} (<a href={THIRD_PARTY_URL}>all, with licences</a>). Inkwell 0.2, on the
        <a href={LEGACY_BRANCH_URL}>legacy/0.2</a> branch, was originally based on <a href={HANDY_URL}>Handy</a> by CJ Pais.
      </p>
      <p>The glow at the top of this page is the app’s own orb shader, ported to WebGL. This site sets no cookies and runs no analytics.</p>
    </div>
    <ul class="colophon-links" aria-label="Project links">
      <li><a href={GITHUB_URL}>GitHub</a></li>
      <li><a href={RELEASES_URL}>All releases</a></li>
      <li><a href={ISSUES_URL}>Issues</a></li>
      <li><a href={BUILD_FROM_SOURCE_URL}>Build from source</a></li>
      <li><a href={CONTRIBUTING_URL}>Contributing</a></li>
      <li><a href={SECURITY_URL}>Security</a></li>
      <li><a href={LICENSE_URL}>MIT licence</a></li>
      <li><a href={`${base}#privacy`}>Privacy</a></li>
      <li><a href={`${base}#code-signing`}>Code signing</a></li>
    </ul>
  </div>
</footer>
