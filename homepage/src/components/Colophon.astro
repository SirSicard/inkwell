---
import {
  AUTHOR_NAME,
  AUTHOR_URL,
  BUILD_FROM_SOURCE_URL,
  CONTRIBUTING_URL,
  FLUIDAUDIO_URL,
  GITHUB_URL,
  HANDY_URL,
  ISSUES_URL,
  LICENSE_URL,
  LLAMA_CPP_URL,
  NEMO_SPEECH_URL,
  RELEASES_URL,
  SECURITY_URL,
  SHARED_VERSION,
  SILERO_VAD_URL,
} from '../lib/constants';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
---

<footer class="colophon" aria-labelledby="colophon-title">
  <div class="wrap colophon-grid">
    <div class="colophon-text">
      <h2 id="colophon-title" class="sr-only">Colophon</h2>
      <p>
        <span translate="no">Inkwell</span>{SHARED_VERSION && ` ${SHARED_VERSION}`} is free and MIT licensed, built by
        <a href={AUTHOR_URL}>{AUTHOR_NAME}</a>. Inkwell 0.2 was originally based on <a href={HANDY_URL}>Handy</a>
        by CJ Pais. Speech recognition by <a href={LLAMA_CPP_URL}>llama.cpp</a> running Qwen3-ASR, live words by
        <a href={FLUIDAUDIO_URL}>FluidAudio</a>, speaker labels by <a href={NEMO_SPEECH_URL}>NeMo-Speech.cpp</a>,
        voice detection by <a href={SILERO_VAD_URL}>Silero VAD</a>.
      </p>
      <p>
        The app is native on each system over one Rust core: SwiftUI and AppKit with a Metal ink on the Mac,
        WinUI 3 with a Direct3D ink on Windows, and SQLite for the library.
      </p>
      <p>This site sets no cookies and runs no analytics.</p>
    </div>
    <ul class="colophon-links" aria-label="Project links">
      <li><a href={GITHUB_URL}>GitHub</a></li>
      <li><a href={RELEASES_URL}>All releases</a></li>
      <li><a href={ISSUES_URL}>Issues</a></li>
      <li><a href={BUILD_FROM_SOURCE_URL}>Build from source</a></li>
      <li><a href={CONTRIBUTING_URL}>Contributing</a></li>
      <li><a href={SECURITY_URL}>Security</a></li>
      <li><a href={LICENSE_URL}>MIT licence</a></li>
      <li><a href={`${base}#privacy`}>Privacy</a></li>
      <li><a href={`${base}#code-signing`}>Code signing</a></li>
    </ul>
  </div>
</footer>
