---
// The header sits in the dark hero (and on the 404's page): the wordmark, the four jobs of the page,
// the source, and the theme switch (light, system, dark), which needs JS and is hidden without it.
import { GITHUB_URL } from '../lib/constants';

interface Props {
  /** On the 404 the in-page anchors point back at the homepage. */
  base?: string;
}
const { base = '' } = Astro.props;
---

<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label="Inkwell, home" translate="no"><span class="wordmark-orb" aria-hidden="true"></span>Inkwell</a>
  <nav class="site-nav" aria-label="Primary">
    <ul>
      <li class="nav-wide"><a href={`${base}#dictation`}>Dictation</a></li>
      <li class="nav-wide"><a href={`${base}#meetings`}>Meetings</a></li>
      <li class="nav-wide"><a href={`${base}#privacy`}>Privacy</a></li>
      <li class="nav-download"><a href={`${base}#download`}>Download</a></li>
      <li>
        <a class="gh" href={GITHUB_URL} aria-label="Source on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        </a>
      </li>
    </ul>
  </nav>
  <div class="theme-switch js-only" role="group" aria-label="Theme">
    <button type="button" data-theme-set="light" aria-pressed="false" title="Light">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      <span class="sr-only">Light</span>
    </button>
    <button type="button" data-theme-set="system" aria-pressed="true" title="System">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor"></path></svg>
      <span class="sr-only">Match the system</span>
    </button>
    <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
      <span class="sr-only">Dark</span>
    </button>
  </div>
</header>
