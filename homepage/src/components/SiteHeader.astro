---
import { GITHUB_URL } from '../lib/constants';

interface Props {
  /** On the 404 the in-page anchors point back at the homepage. */
  base?: string;
}
const { base = '' } = Astro.props;
---

<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label="Inkwell, home" translate="no">Inkwell</a>
  <nav aria-label="Primary">
    <ul>
      <li class="nav-wide"><a href={`${base}#features`}>Features</a></li>
      <li class="nav-mid"><a href={`${base}#models`}>Models</a></li>
      <li><a href={`${base}#privacy`}>Privacy</a></li>
      <li class="nav-wide"><a href={GITHUB_URL}>Source</a></li>
      <li><a href={`${base}#download`}>Download</a></li>
    </ul>
  </nav>
</header>
