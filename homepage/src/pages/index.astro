---
// The homepage for Inkwell 1.0, in Glow: a dark hero (the app's orb, the product and the download),
// then the page in the visitor's theme, with the Meetings band always dark. Ordered by the jobs:
// dictation, meetings, the library, stats, models, privacy, consent, download. Every fact comes from
// the 1.0 README; see ../lib/constants.ts.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Dictation from '../components/Dictation.astro';
import Meetings from '../components/Meetings.astro';
import Library from '../components/Library.astro';
import Models from '../components/Models.astro';
import Privacy from '../components/Privacy.astro';
import Consent from '../components/Consent.astro';
import Install from '../components/Install.astro';
import CodeSigning from '../components/CodeSigning.astro';
import Colophon from '../components/Colophon.astro';
import { APP_VERSION, AUTHOR_NAME, AUTHOR_URL, LICENSE_URL, RELEASES_LATEST_URL, SITE_URL } from '../lib/constants';

const title = 'Inkwell: dictation and meeting notes that stay on your machine';
const description =
  'Hold a key, speak, let go: the text lands in the app you were typing in. Meetings are recorded as two streams and transcribed on your own Mac or PC. Free, MIT licensed, no account.';

// Only fields that are true. No rating or review: there are none to give.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Inkwell',
  description,
  url: `${SITE_URL}/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 26 or later (Apple silicon), Windows 11 24H2 or later (x64)',
  softwareVersion: APP_VERSION,
  downloadUrl: RELEASES_LATEST_URL,
  license: LICENSE_URL,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: AUTHOR_NAME, url: AUTHOR_URL },
};
---

<Base title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <a class="skip" href="#main">Skip to content</a>
  <Hero />
  <main id="main">
    <Dictation />
    <Meetings />
    <Library />
    <Models />
    <Privacy />
    <Consent />
    <Install />
    <CodeSigning />
  </main>
  <Colophon />

  <script>
    import { enhanceDownloads } from '../lib/platform';
    import { themeSwitch, copyButtons } from '../lib/theme';
    import { startHero } from '../lib/hero';

    // Each enhancement stands alone: one failing never takes the others, or the content, down.
    try {
      themeSwitch();
    } catch {
      /* the system theme stays */
    }
    try {
      enhanceDownloads();
    } catch {
      /* both buttons stay equal */
    }
    // Long lists sit in <details> to keep the phone page short; wide screens open them.
    if (window.matchMedia('(min-width: 46rem)').matches) {
      document.querySelectorAll<HTMLDetailsElement>('details.wide-open').forEach((d) => (d.open = true));
    }
    try {
      copyButtons();
    } catch {
      /* the hash stays selectable */
    }
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (hero) {
      // The orb waits until the page has painted and gone quiet: it is decoration over working content.
      const go = () => {
        try {
          startHero(hero);
        } catch {
          /* the CSS glow and the still frame stay */
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1500 });
      else setTimeout(go, 300);
    }
  </script>
</Base>
