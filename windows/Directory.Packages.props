<Project>
  <!-- Every NuGet dependency and its version, in one place. Licences: scripts/nuget-licences.ps1
       checks each restored package (direct and transitive) against the allowlist in CI. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app. The Windows App SDK's component packages, not its metapackage (which adds the AI,
         ML, Search and Widgets packages): WinUI brings Base, Foundation, InteractiveExperiences,
         WebView2 and the SDK build tools. Their licences are Microsoft's, accepted by the
         maintainer and listed in scripts/nuget-licence-exceptions.json. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- The tray icon (MIT). -->
    <PackageVersion Include="WinUIEx" Version="2.9.3" />
    <!-- The installer's hooks and in-app updates (MIT). The same version as the vpk tool that packs
         the installer (.config/dotnet-tools.json): bump both together. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- The ink (Inkwell.Ink): Direct3D 11, DXGI, DirectComposition, Direct2D, DirectWrite and
         Win32 declarations (MIT), NativeAOT-safe. -->
    <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests (never shipped): xUnit v3 on the VSTest runner, without Microsoft.Testing.Platform. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
</Project>
