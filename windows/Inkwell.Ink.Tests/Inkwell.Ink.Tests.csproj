<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ink's tests. The GPU ones draw with WARP (Direct3D's software rasteriser), so they run
       on CI's windows runner and over SSH, where there is no desktop and maybe no GPU. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inkwell.Ink\Inkwell.Ink.csproj" />
  </ItemGroup>
</Project>
