<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# over the core's C ABI (inkwell.h): the generated P/Invoke declarations and event types,
       the session, and the hop to the UI thread. No WinUI here, so it tests headless. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trim and AOT analyzers on: the code stays AOT-safe, though the app publishes ReadyToRun
         (Inkwell.csproj says why). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inkwell.Core.Tests" />
  </ItemGroup>
</Project>
