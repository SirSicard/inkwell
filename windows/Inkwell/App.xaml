<?xml version="1.0" encoding="utf-8"?>
<!-- The design tokens: Glow's, from the generated token dictionary (Generated/GlowTokens.xaml,
     from design/tokens.json), named here for the screens. The window's mode (light, dark or the system's: GlowTheme) picks the theme
     dictionary; the you and them colours are two brushes GlowTheme keeps up to date
     (GlowYouBrush, GlowThemBrush), for dots and lanes only: text never uses them. High Contrast
     gets solid cards, no translucency and stronger borders, in the system's colours. -->
<Application
    x:Class="Inkwell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Generated/GlowTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InkWindowBrush" Color="{ThemeResource GlowBackgroundColor}" />
                    <SolidColorBrush x:Key="InkSurfaceBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InkTextBrush" Color="{ThemeResource GlowTextColor}" />
                    <SolidColorBrush x:Key="InkSecondaryTextBrush" Color="{ThemeResource GlowSecondaryColor}" />
                    <SolidColorBrush x:Key="InkCardBrush" Color="{ThemeResource GlowCardColor}" />
                    <AcrylicBrush
                        x:Key="InkCardAcrylicBrush"
                        FallbackColor="{ThemeResource GlowCardColor}"
                        TintColor="{ThemeResource GlowCardColor}"
                        TintLuminosityOpacity="0.4"
                        TintOpacity="1" />
                    <SolidColorBrush x:Key="InkCardBorderBrush" Color="{ThemeResource GlowBorderColor}" Opacity="0.6" />
                    <SolidColorBrush x:Key="InkBorderBrush" Color="{ThemeResource GlowBorderColor}" />
                    <SolidColorBrush x:Key="InkSeparatorBrush" Color="{ThemeResource GlowBorderColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="InkChipBrush" Color="{ThemeResource GlowTextColor}" Opacity="0.07" />
                    <SolidColorBrush x:Key="InkDueChipBrush" Color="{ThemeResource GlowTextColor}" Opacity="0.1" />
                    <SolidColorBrush x:Key="InkDueTextBrush" Color="{ThemeResource GlowTextColor}" />
                    <SolidColorBrush x:Key="InkAlertChipBrush" Color="{ThemeResource GlowAlertColor}" Opacity="0.14" />
                    <SolidColorBrush x:Key="InkAlertTextBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkAlertCardBrush" Color="{ThemeResource GlowAlertCardColor}" />
                    <SolidColorBrush x:Key="InkAlertBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkRecordingBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkButtonFillBrush" Color="{ThemeResource GlowButtonFillColor}" />
                    <SolidColorBrush x:Key="InkButtonLabelBrush" Color="{ThemeResource GlowButtonLabelColor}" />
                    <!-- The navigation sits on the orb: no pane or content fill of its own. -->
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

                    <StaticResource x:Key="InkInputFillColor" ResourceKey="GlowTextColor" />
                    <StaticResource x:Key="InkInputActiveColor" ResourceKey="GlowCardColor" />
                    <StaticResource x:Key="InkInputBorderColor" ResourceKey="GlowBorderColor" />
                    <StaticResource x:Key="InkInputHoverBorderColor" ResourceKey="GlowSecondaryColor" />
                    <StaticResource x:Key="InkInputFocusColor" ResourceKey="GlowTextColor" />
                    <x:Double x:Key="InkInputFillOpacity">0.07</x:Double>
                    <x:Double x:Key="InkInputHoverOpacity">0.1</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InkWindowBrush" Color="{ThemeResource GlowBackgroundColor}" />
                    <SolidColorBrush x:Key="InkSurfaceBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InkTextBrush" Color="{ThemeResource GlowTextColor}" />
                    <!-- Lighter than the token's #A49FB4 (6.9:1 on a card): Segoe UI's thin 13 epx captions,
                         light on dark, read faint at that. #BCB7CA is 9.1:1, still a step under the text. -->
                    <SolidColorBrush x:Key="InkSecondaryTextBrush" Color="#FFBCB7CA" />
                    <SolidColorBrush x:Key="InkCardBrush" Color="{ThemeResource GlowCardColor}" />
                    <AcrylicBrush
                        x:Key="InkCardAcrylicBrush"
                        FallbackColor="{ThemeResource GlowCardColor}"
                        TintColor="{ThemeResource GlowCardColor}"
                        TintLuminosityOpacity="0.4"
                        TintOpacity="1" />
                    <SolidColorBrush x:Key="InkCardBorderBrush" Color="#FFFFFFFF" Opacity="0.06" />
                    <SolidColorBrush x:Key="InkBorderBrush" Color="{ThemeResource GlowBorderColor}" />
                    <SolidColorBrush x:Key="InkSeparatorBrush" Color="{ThemeResource GlowBorderColor}" Opacity="0.8" />
                    <SolidColorBrush x:Key="InkChipBrush" Color="{ThemeResource GlowTextColor}" Opacity="0.08" />
                    <SolidColorBrush x:Key="InkDueChipBrush" Color="{ThemeResource GlowTextColor}" Opacity="0.1" />
                    <SolidColorBrush x:Key="InkDueTextBrush" Color="{ThemeResource GlowTextColor}" />
                    <SolidColorBrush x:Key="InkAlertChipBrush" Color="{ThemeResource GlowAlertColor}" Opacity="0.14" />
                    <SolidColorBrush x:Key="InkAlertTextBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkAlertCardBrush" Color="{ThemeResource GlowAlertCardColor}" />
                    <SolidColorBrush x:Key="InkAlertBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkRecordingBrush" Color="{ThemeResource GlowAlertColor}" />
                    <SolidColorBrush x:Key="InkButtonFillBrush" Color="{ThemeResource GlowButtonFillColor}" />
                    <SolidColorBrush x:Key="InkButtonLabelBrush" Color="{ThemeResource GlowButtonLabelColor}" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

                    <StaticResource x:Key="InkInputFillColor" ResourceKey="GlowTextColor" />
                    <StaticResource x:Key="InkInputActiveColor" ResourceKey="GlowCardColor" />
                    <StaticResource x:Key="InkInputBorderColor" ResourceKey="GlowBorderColor" />
                    <StaticResource x:Key="InkInputHoverBorderColor" ResourceKey="GlowSecondaryColor" />
                    <StaticResource x:Key="InkInputFocusColor" ResourceKey="GlowTextColor" />
                    <x:Double x:Key="InkInputFillOpacity">0.08</x:Double>
                    <x:Double x:Key="InkInputHoverOpacity">0.1</x:Double>
                </ResourceDictionary>
                <!-- High Contrast: the user's own colours, solid cards, borders in the text colour. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InkWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkSurfaceBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InkTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkCardAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkDueChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkDueTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InkAlertChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkAlertTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InkAlertCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkAlertBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InkRecordingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InkButtonFillBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="InkButtonLabelBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

                    <StaticResource x:Key="InkInputFillColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="InkInputActiveColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="InkInputBorderColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="InkInputHoverBorderColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="InkInputFocusColor" ResourceKey="SystemColorHighlightColor" />
                    <x:Double x:Key="InkInputFillOpacity">1</x:Double>
                    <x:Double x:Key="InkInputHoverOpacity">1</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Concrete root resources override WinUI's built-in theme aliases. Keep only the
                 colours/opacity theme-specific, so pointer and focus states resolve these brushes. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource InkInputFillColor}" Opacity="{ThemeResource InkInputFillOpacity}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource InkInputFillColor}" Opacity="{ThemeResource InkInputHoverOpacity}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource InkInputActiveColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource InkInputBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource InkInputHoverBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource InkInputFocusColor}" />
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>

            <!-- The you and them colours of the mode shown (GlowTheme sets them): dots and lanes only. -->
            <SolidColorBrush x:Key="GlowYouBrush" Color="#FF6B5CFF" />
            <SolidColorBrush x:Key="GlowThemBrush" Color="#FFFFA34D" />

            <!-- The accent is the button fill (text-coloured, so no control renders in the system's
                 accent or in a dot colour): WinUI fills accent controls with Dark1 in the light
                 theme (Glow's day button, #1D1B2E) and Light2 in the dark theme (its night button,
                 #EDEAF2), with white or black words, as Glow's labels. The other steps sit between. -->
            <Color x:Key="SystemAccentColor">#FF4A4760</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8D8A9E</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEDEAF2</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF6F4F9</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1D1B2E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF151421</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0E0D16</Color>

            <!-- The three system faces: Segoe UI Variable for the interface, Sitka for display and
                 what the user reads as a document, Cascadia Mono for timestamps and versions. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="InkInterfaceFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="InkDisplayFontFamily">Sitka Display</FontFamily>
            <FontFamily x:Key="InkReadingFontFamily">Sitka Text</FontFamily>
            <FontFamily x:Key="InkMonoFontFamily">Cascadia Mono</FontFamily>

            <!-- The screens' type, at Glow's sizes. -->
            <Style x:Key="InkGreetingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkDisplayFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowGreetingFontSize}" />
                <Setter Property="LineHeight" Value="{StaticResource GlowGreetingFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
            </Style>
            <Style x:Key="InkScreenTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkDisplayFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowScreenTitleFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
            </Style>
            <Style x:Key="InkHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkDisplayFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowHeadingFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
            </Style>
            <Style x:Key="InkBodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkInterfaceFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowBodyFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
            </Style>
            <Style x:Key="InkReadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkReadingFontFamily}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
            </Style>
            <Style x:Key="InkCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkInterfaceFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowCaptionFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryTextBrush}" />
            </Style>
            <Style x:Key="InkTimestampStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryTextBrush}" />
            </Style>
            <!-- A section's small label, in sentence case, as the canvas's "Last meeting". -->
            <Style x:Key="InkEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InkInterfaceFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource GlowEyebrowFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryTextBrush}" />
            </Style>
            <Style x:Key="InkAlertTextStyle" TargetType="TextBlock" BasedOn="{StaticResource InkCaptionStyle}">
                <Setter Property="Foreground" Value="{ThemeResource InkAlertBrush}" />
            </Style>
            <!-- Glow's card: translucent over the orb (in-app acrylic; solid where Windows' transparency
                 effects are off, and in High Contrast), a hairline, 22 px corners. -->
            <!-- A Settings row after a section's first: a faint rule above it, so one row's caption
                 doesn't run into the next row's name. -->
            <Style x:Key="InkSettingRowStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource InkSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="0,14,0,0" />
            </Style>
            <Style x:Key="InkCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InkCardAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InkCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource GlowCardCornerRadius}" />
                <Setter Property="Padding" Value="22,18" />
            </Style>
            <!-- A card inside a card (Settings' section cards hold the permission cards and the 0.2
                 notes): flat, no second acrylic, a hairline, and the 14 px corners of Appearance's
                 rows. High Contrast's brushes make it the same solid card as InkCardStyle. -->
            <Style x:Key="InkInsetCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InkCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InkCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <!-- Editing controls share a softer shape; native templates retain selection, IME,
                 context menus, disabled states and the full border keyboard-focus treatment. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <!-- Pill buttons: the answer in the button fill, every other button on a light wash. -->
            <Style x:Key="InkAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource GlowPillCornerRadius}" />
                <Setter Property="Padding" Value="18,8,18,9" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource GlowPillCornerRadius}" />
                <Setter Property="Padding" Value="16,7,16,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
