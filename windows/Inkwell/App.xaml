<?xml version="1.0" encoding="utf-8"?>
<!-- The design tokens. The OS owns the chrome (Mica, native controls, the system fonts); the accent
     is Inkwell's sepia, so no control renders in the system's accent colour. -->
<Application
    x:Class="Inkwell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The accent: sepia #7E5431, as on the Mac. WinUI paints accent fills with Dark1 in
                 the light theme (white on it: 8.2:1) and Light2 in the dark theme (on night paper
                 #121419: 6.8:1). The lighter steps mix sepia with white by 20, 40 and 60 %, the
                 darker ones with black by 15, 30 and 45 %. Defined here, above the merged
                 XamlControlsResources, so every control's theme resources resolve to them. -->
            <Color x:Key="SystemAccentColor">#FF7E5431</Color>
            <Color x:Key="SystemAccentColorLight1">#FF98765A</Color>
            <Color x:Key="SystemAccentColorLight2">#FFB29883</Color>
            <Color x:Key="SystemAccentColorLight3">#FFCBBBAD</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6B472A</Color>
            <Color x:Key="SystemAccentColorDark2">#FF583B22</Color>
            <Color x:Key="SystemAccentColorDark3">#FF452E1B</Color>

            <!-- The three system faces: Segoe UI Variable for the interface, Sitka Text for what
                 the user reads as a document, Cascadia Mono for timestamps and versions. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="InkInterfaceFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="InkReadingFontFamily">Sitka Text</FontFamily>
            <FontFamily x:Key="InkMonoFontFamily">Cascadia Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
