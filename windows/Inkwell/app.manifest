<?xml version="1.0" encoding="utf-8"?>
<!-- Inkwell.exe's own manifest. The Windows App SDK's build adds its class registrations to it.
     Without it the app ran DPI-unaware (its window's awareness read 0 on a desktop run): on a scaled
     display Windows stretches the window and the Drop as bitmaps, and the Drop's per-monitor
     placement (GetDpiForMonitor, WM_DPICHANGED) is told 96 dpi everywhere. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" name="Inkwell.app" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <dpiAwareness>PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
