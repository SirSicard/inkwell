<?xml version="1.0" encoding="utf-8"?>
<!-- The shell window: Mica behind everything, the content drawn into the title bar. Empty for now:
     the screens come later. It shows only whether the core started. -->
<Window
    x:Class="Inkwell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell"
    Title="Inkwell">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea">
            <TextBlock
                Margin="16,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource InkInterfaceFontFamily}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Inkwell" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <!-- The ink (S3.4) until the screens give it its zone: the same state as the Drop. -->
            <local:InkPanel x:Name="Ink" Width="96" Height="168" HorizontalAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InkReadingFontFamily}"
                FontSize="40"
                Text="Inkwell" />
            <!-- Spins only while the core starts: nothing animates once it is ready. -->
            <ProgressRing x:Name="Starting" IsActive="True" Width="24" Height="24" />
            <TextBlock
                x:Name="Status"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InkInterfaceFontFamily}"
                Text="Starting the core" />
            <!-- Why the Drop's ink cannot draw (S3.4), when it cannot. -->
            <TextBlock
                x:Name="InkStatus"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InkInterfaceFontFamily}"
                TextWrapping="Wrap"
                MaxWidth="480"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="Version"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InkMonoFontFamily}"
                Opacity="0.62" />
        </StackPanel>
    </Grid>
</Window>
