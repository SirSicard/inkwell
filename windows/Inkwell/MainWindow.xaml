<?xml version="1.0" encoding="utf-8"?>
<!-- The shell window: Mica behind everything, the content drawn into the title bar.

       ┌────────────┬──────┬──────────────────────────────┐
       │ navigation │ ink  │ the route's screen            │
       │ (Mica)     │ rail │ paper / night paper           │
       └────────────┴──────┴──────────────────────────────┘

     The navigation is WinUI's NavigationView, so every item is a Narrator element with a working
     invoke, and the arrow keys move through it. The rail is where the ink lives beside the
     content (S3.4 draws it): on Today it widens into the full ink zone, with Record now at its
     foot; elsewhere it is a narrow paper strip. The ink itself is decorative (Narrator skips it);
     the controls at its foot are not. -->
<Window
    x:Class="Inkwell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell"
    Title="Inkwell">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="16,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource InkInterfaceFontFamily}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Inkwell" />
            <!-- The core's state: quiet once it is ready. Clear of the caption buttons. -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,150,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!-- Spins only while the core starts: nothing animates once it is ready. -->
                <ProgressRing x:Name="Starting" Width="16" Height="16" IsActive="True" />
                <TextBlock
                    x:Name="Status"
                    FontFamily="{StaticResource InkInterfaceFontFamily}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Starting the core" />
                <!-- Why the Drop's ink cannot draw (S3.4), when it cannot. -->
                <TextBlock
                    x:Name="InkStatus"
                    MaxWidth="420"
                    FontFamily="{StaticResource InkInterfaceFontFamily}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="Version"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource InkMonoFontFamily}"
                    FontSize="11"
                    Opacity="0.62" />
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AutomationProperties.Name="Sections"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="208"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <!-- "Search everything said" (the canvas's toolbar search): the Library's matches. -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="Search"
                    AutomationProperties.Name="Search everything said"
                    PlaceholderText="Search everything said"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted" />
            </NavigationView.AutoSuggestBox>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="InkRail" Width="64" Background="{ThemeResource InkZoneBrush}" BorderBrush="{ThemeResource InkBorderBrush}" BorderThickness="0,0,1,0">
                    <!-- The ink (S3.4). Decorative: the state it shows is spoken by the Drop and the screens. -->
                    <Border x:Name="InkHost" AutomationProperties.AccessibilityView="Raw">
                        <local:InkPanel x:Name="Ink" />
                    </Border>
                    <!-- Today's foot of the ink zone: whether Inkwell listens, and Record now. -->
                    <ContentPresenter x:Name="RailFoot" Margin="22" VerticalAlignment="Bottom" />
                </Grid>
                <ContentPresenter
                    x:Name="Screen"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Background="{ThemeResource InkSurfaceBrush}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
