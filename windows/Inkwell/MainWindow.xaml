<?xml version="1.0" encoding="utf-8"?>
<!-- The shell window, in Glow: the orb behind everything, the content over it, the edge glow on top.

       ┌──────────────────────────────────────────────────────┐
       │ Inkwell · Today                       …   _ □ ×      │  title bar (the content drawn into it)
       │ Inkwell        │                                     │
       │ [search]       │  the route's screen                 │
       │ Today          │                                     │
       │ Library        │        ( the orb, behind )          │
       │ Owed  2        │                                     │
       │ Settings       │                                     │
       └──────────────────────────────────────────────────────┘

     No Mica: the orb is the backdrop, on the mode's background. The navigation is WinUI's
     NavigationView with a transparent pane, so every item is a Narrator element with a working
     invoke, and the arrow keys move through it. The orb and the edge are decorative (Narrator
     skips them); neither takes clicks. The window's keys are its accelerators (MainWindow.xaml.cs),
     and the title bar's "…" holds File and View. -->
<Window
    x:Class="Inkwell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell"
    Title="Inkwell">
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- The mode's background, on a layer of its own: Root carries the mode (GlowTheme sets its
             RequestedTheme), and a theme resource on Root's own Background kept the theme it had,
             so Light showed night's background behind day's text. -->
        <Border Background="{ThemeResource InkWindowBrush}" />
        <!-- The orb (S3.4's ink, as Glow draws it). Decorative: the state it shows is spoken by the
             Drop and the screens. -->
        <local:InkPanel x:Name="Orb" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- The caption buttons' room. -->
                    <ColumnDefinition Width="146" />
                </Grid.ColumnDefinitions>
                <!-- The drag region: the window's name, the route, and the core's state only when it is not ready. -->
                <Grid x:Name="TitleBarArea" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="WindowTitle"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InkInterfaceFontFamily}"
                        Foreground="{ThemeResource InkSecondaryTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Inkwell" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!-- Spins only while the core starts: nothing animates once it is ready. -->
                        <ProgressRing x:Name="Starting" Width="16" Height="16" IsActive="True" />
                        <TextBlock
                            x:Name="Status"
                            FontFamily="{StaticResource InkInterfaceFontFamily}"
                            Foreground="{ThemeResource InkSecondaryTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Starting the core" />
                        <!-- Why the Drop's ink cannot draw (S3.4), when it cannot. -->
                        <TextBlock
                            x:Name="InkStatus"
                            MaxWidth="420"
                            FontFamily="{StaticResource InkInterfaceFontFamily}"
                            Foreground="{ThemeResource InkAlertBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <!-- File and View (the Mac's menus): Windows has no menu bar, so they sit behind "…". -->
                <Button
                    x:Name="Overflow"
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="More"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="More">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="OverflowMenu" Opening="OnOverflowOpening" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>
            <NavigationView
                x:Name="Nav"
                Grid.Row="1"
                AutomationProperties.Name="Sections"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                OpenPaneLength="220"
                PaneDisplayMode="Left"
                SelectionChanged="OnNavigationSelectionChanged">
                <!-- No fill of its own over the orb, in any mode. On the control itself: its template
                     takes these brushes from here, not from App.xaml's overrides, and painted the
                     content in Windows' layer fill (50% white by day). -->
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                </NavigationView.Resources>
                <!-- The wordmark (the tall rail and its knockout are retired). -->
                <NavigationView.PaneHeader>
                    <TextBlock
                        Margin="16,4,0,10"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="{StaticResource InkDisplayFontFamily}"
                        FontSize="{StaticResource GlowHeadingFontSize}"
                        Foreground="{ThemeResource InkTextBrush}"
                        Text="Inkwell" />
                </NavigationView.PaneHeader>
                <!-- "Search everything said" (the canvas's toolbar search): the Library's matches. Ctrl+F. -->
                <NavigationView.AutoSuggestBox>
                    <AutoSuggestBox
                        x:Name="Search"
                        AutomationProperties.Name="Search everything said"
                        PlaceholderText="Search everything said"
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchSubmitted" />
                </NavigationView.AutoSuggestBox>
                <ContentPresenter
                    x:Name="Screen"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </NavigationView>
        </Grid>
        <!-- The edge glow, above everything; it takes no clicks. -->
        <local:EdgeGlowView x:Name="Edge" />
    </Grid>
</Window>
