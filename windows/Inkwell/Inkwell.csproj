<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 shell: an unpackaged, self-contained app (nothing is installed system-wide:
       the Windows App SDK's runtime is copied next to the exe), published with NativeAOT. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\Inkwell.ico</ApplicationIcon>
    <RootNamespace>Inkwell</RootNamespace>
    <!-- NativeAOT on publish (dotnet publish -c Release). The fallback, if a NativeAOT build
         breaks: -p:PublishAot=false -p:PublishReadyToRun=true. -->
    <PublishAot>true</PublishAot>
    <!-- Program.cs is the entry point: Velopack's install and update hooks run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Inkwell's copyright notice in Inkwell.exe's file properties, as About shows it under the
         version (AboutModel.CopyrightLine, LICENSE's line): the Windows SDK's licence asks an app
         that ships its code to display its own. -->
    <Copyright>Copyright (c) 2026 Mattias Hjemgaard</Copyright>
  </PropertyGroup>
  <!-- A release's version (win-release.yml: -p:InkVersion=X.Y.Z, from the tag): the file version,
       and the metadata About reads (AppVersion.cs). Any other build has none: "development build". -->
  <PropertyGroup Condition="'$(InkVersion)' != ''">
    <Version>$(InkVersion)</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(InkVersion)' != ''">
    <AssemblyMetadata Include="InkVersion" Value="$(InkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="WinUIEx" />
    <!-- The installer's hooks and in-app updates (MIT). -->
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inkwell.Core\Inkwell.Core.csproj" />
    <!-- The ink and the Drop (S3.4). -->
    <ProjectReference Include="..\Inkwell.Ink\Inkwell.Ink.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Inkwell.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The core, and the engines' DLLs beside it: every DLL in InkCoreDir, which for a release is
         the folder windows/scripts/build-core.ps1 fills with exactly those (inkwell-core). They must
         sit beside Inkwell.exe, where Windows looks first: sherpa-onnx's onnxruntime.dll there, not
         Windows' own older one in System32. Missing, the app still starts and says the core did not
         start. -->
    <Content Include="$(InkCoreDir)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
