<?xml version="1.0" encoding="utf-8"?>
<!-- One permission card's row (the canvas's Permissions board; the Mac's PermissionRow): its state
     mark, its name and line, and its button or its state in words. Red paper only while it is off.
     Narrator reads the row as "Title: state" (set in code). -->
<UserControl
    x:Class="Inkwell.Screens.PermissionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens">
    <Grid>
        <Border x:Name="AlertFill" Background="{ThemeResource InkAlertCardBrush}" Visibility="Collapsed" />
        <Rectangle
            x:Name="TopRule"
            Height="1"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw"
            Fill="{ThemeResource InkSeparatorBrush}" />
        <Grid x:Name="Root" Padding="16,13" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The state mark: decorative (the row's name says the state). -->
            <Grid Width="22" Height="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Ellipse x:Name="AllowedDot" Width="18" Height="18" Fill="{ThemeResource InkTextBrush}" />
                <FontIcon
                    x:Name="AllowedCheck"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="10"
                    Foreground="{ThemeResource InkWindowBrush}"
                    Glyph="&#xE73E;" />
                <Ellipse
                    x:Name="OffRing"
                    Width="17"
                    Height="17"
                    Stroke="{ThemeResource InkAlertBrush}"
                    StrokeDashArray="1.67,1.33"
                    StrokeThickness="1.8" />
                <Ellipse
                    x:Name="PlainRing"
                    Width="17"
                    Height="17"
                    Stroke="{ThemeResource InkSecondaryTextBrush}"
                    StrokeThickness="1.5" />
                <ProgressRing x:Name="CheckingRing" Width="16" Height="16" IsActive="False" />
            </Grid>
            <!-- The name and line, then the button or state beside them; under them where the row is
                 narrow (Settings at its narrowest). -->
            <local:LineOrStackPanel Grid.Column="1" VerticalAlignment="Center" Fill="0" FillMinimum="180" Spacing="14">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold" Style="{StaticResource InkBodyStyle}" />
                    <TextBlock x:Name="LineText" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock x:Name="OffLineText" FontSize="13" Style="{StaticResource InkBodyStyle}" />
                </StackPanel>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="ActionButton" VerticalAlignment="Center" Click="OnAction" />
                    <TextBlock
                        x:Name="StateText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Style="{StaticResource InkCaptionStyle}" />
                </Grid>
            </local:LineOrStackPanel>
        </Grid>
    </Grid>
</UserControl>
