<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (the canvas's Settings board): a list of the sections on the left, and one scrolling
     page with every section top to bottom. Choosing a section in the list scrolls to it; scrolling
     marks the section in view. Each section sits on its own card, Glow's card as Today's
     (InkCardStyle: translucent over the orb, solid in High Contrast), with its Level 2 heading
     inside, so in dark mode one section does not run into the next. -->
<UserControl
    x:Class="Inkwell.Screens.SettingsScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Padding="12,28" BorderBrush="{ThemeResource InkBorderBrush}" BorderThickness="0,0,1,0">
            <ListView
                x:Name="SectionList"
                AutomationProperties.Name="Settings sections"
                SelectionChanged="OnSectionChosen"
                SelectionMode="Single" />
        </Border>
        <ScrollViewer x:Name="Scroller" Grid.Column="1" ViewChanged="OnScrolled">
            <StackPanel x:Name="Sections" Padding="40,28" Spacing="16">
                <TextBlock Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkScreenTitleStyle}" Text="Settings" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
