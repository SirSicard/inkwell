<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Storage: how long records are kept, where the library lives, and how much room each
     part takes. As the Mac's StorageSection ("Show in File Explorer" for the Finder). -->
<UserControl
    x:Class="Inkwell.Screens.StorageSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens"
    Loaded="OnLoaded">
    <StackPanel Spacing="10">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Storage" />
        <local:SettingColumnsPanel>
            <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource InkBodyStyle}" Text="Keep records" />
            <StackPanel Spacing="4">
                <ComboBox
                    x:Name="Keep"
                    AutomationProperties.HelpText="{x:Bind local:StorageSection.RetentionDetail}"
                    AutomationProperties.Name="Keep records"
                    SelectionChanged="OnKeepChanged" />
                <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" Text="{x:Bind local:StorageSection.RetentionDetail}" />
            </StackPanel>
        </local:SettingColumnsPanel>
        <!-- The path, then its button; the button under it where both don't fit on one line. -->
        <local:LineOrStackPanel x:Name="Folder">
            <TextBlock x:Name="FolderPath" VerticalAlignment="Center" AutomationProperties.Name="Library folder" IsTextSelectionEnabled="True" Style="{StaticResource InkTimestampStyle}" TextWrapping="Wrap" />
            <Button x:Name="Reveal" VerticalAlignment="Center" Click="OnReveal" Content="Show in File Explorer" />
        </local:LineOrStackPanel>
        <TextBlock x:Name="Failed" Style="{StaticResource InkAlertTextStyle}" Text="{x:Bind local:StorageSection.FailedText}" Visibility="Collapsed" />
        <ProgressRing x:Name="Measuring" Width="16" Height="16" HorizontalAlignment="Left" AutomationProperties.Name="Measuring" IsActive="False" />
        <StackPanel x:Name="Sizes" Visibility="Collapsed" Spacing="6">
            <local:SettingColumnsPanel>
                <TextBlock Style="{StaticResource InkBodyStyle}" Text="Library" />
                <TextBlock x:Name="LibrarySize" Style="{StaticResource InkBodyStyle}" Foreground="{ThemeResource InkSecondaryTextBrush}" />
            </local:SettingColumnsPanel>
            <local:SettingColumnsPanel>
                <TextBlock Style="{StaticResource InkBodyStyle}" Text="Recordings" />
                <TextBlock x:Name="RecordingsSize" Style="{StaticResource InkBodyStyle}" Foreground="{ThemeResource InkSecondaryTextBrush}" />
            </local:SettingColumnsPanel>
            <local:SettingColumnsPanel>
                <TextBlock Style="{StaticResource InkBodyStyle}" Text="Models" />
                <TextBlock x:Name="ModelsSize" Style="{StaticResource InkBodyStyle}" Foreground="{ThemeResource InkSecondaryTextBrush}" />
            </local:SettingColumnsPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
