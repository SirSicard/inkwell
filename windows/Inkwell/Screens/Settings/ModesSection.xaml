<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Modes: each mode with how it writes and the apps it is picked for, each app by its
     name and icon (never its exe name). As the Mac's ModesSection and the design's board: name,
     chips, then the apps' tiles and names. -->
<UserControl
    x:Class="Inkwell.Screens.ModesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Inkwell.Core.Screens"
    xmlns:local="using:Inkwell.Screens"
    Loaded="OnLoaded">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Modes" />
            <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,2" Style="{StaticResource InkCaptionStyle}" Text="Picked by the app you&#x2019;re typing in" />
        </StackPanel>
        <TextBlock Style="{StaticResource InkAlertTextStyle}" FontSize="14" Text="{x:Bind local:ModesSection.FailedText}" Visibility="{x:Bind Model.Failed, Mode=OneWay}" />
        <ItemsRepeater x:Name="Rows">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:ModeRowItem">
                    <Grid
                        Padding="0,10"
                        BorderBrush="{ThemeResource InkSeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource InkBodyStyle}" FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <ItemsRepeater ItemsSource="{x:Bind Traits}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="8,2" Background="{ThemeResource InkChipBrush}" CornerRadius="10">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource InkTextBrush}" Text="{x:Bind}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ItemsRepeater ItemsSource="{x:Bind Apps}" Visibility="{x:Bind HasApps}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="core:AppLabel">
                                            <local:AppIconTile App="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock VerticalAlignment="Center" MaxLines="2" Style="{StaticResource InkCaptionStyle}" Text="{x:Bind AppsText}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
