<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Appearance (the canvas's board 7): the mode, the dot presets (light and dark each keep
     their own), your colour and theirs in the mode shown (a picker, or the preset's), the edge glow,
     whether the ink moves, and what High Contrast does. Every change shows at once, everywhere. -->
<UserControl
    x:Class="Inkwell.Screens.AppearanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Appearance" />

        <RadioButtons
            x:Name="ModeChoice"
            AutomationProperties.Name="Mode"
            Header="Mode"
            MaxColumns="3"
            SelectionChanged="OnModeChosen">
            <x:String>Light</x:String>
            <x:String>Dark</x:String>
            <x:String>Match system</x:String>
        </RadioButtons>

        <Grid Margin="0,6,0,0">
            <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InkEyebrowStyle}" Text="Dots" />
            <TextBlock x:Name="DotsNote" HorizontalAlignment="Right" Style="{StaticResource InkCaptionStyle}" />
        </Grid>
        <Grid x:Name="Presets" MaxWidth="560" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock
            x:Name="ColoursHeading"
            Margin="0,6,0,0"
            AutomationProperties.HeadingLevel="Level3"
            Style="{StaticResource InkEyebrowStyle}" />
        <StackPanel x:Name="ColourRows" MaxWidth="560" HorizontalAlignment="Left" Spacing="8" />
        <TextBlock
            MaxWidth="560"
            HorizontalAlignment="Left"
            Style="{StaticResource InkCaptionStyle}"
            Text="The orb's lighter shade follows. A colour too dark for night or too pale for day is adjusted so it stays visible." />

        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Spacing="12">
            <StackPanel Width="260" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource InkBodyStyle}" Text="Glow the window's edge" />
                <TextBlock Style="{StaticResource InkCaptionStyle}" Text="While you dictate or a call records" />
            </StackPanel>
            <ToggleSwitch
                x:Name="EdgeSwitch"
                VerticalAlignment="Center"
                AutomationProperties.Name="Glow the window's edge"
                OffContent=""
                OnContent=""
                Toggled="OnEdgeToggled" />
        </StackPanel>

        <RadioButtons
            x:Name="MotionChoice"
            AutomationProperties.Name="The ink moves"
            Header="The ink moves"
            SelectionChanged="OnMotionChosen">
            <x:String>Follow Windows' Animation effects</x:String>
            <x:String>Always still</x:String>
        </RadioButtons>

        <TextBlock
            MaxWidth="560"
            HorizontalAlignment="Left"
            Style="{StaticResource InkCaptionStyle}"
            Text="High Contrast gives solid cards, no translucency and stronger borders, and dims the orb behind the text." />
        <TextBlock x:Name="FailureLine" Style="{StaticResource InkAlertTextStyle}" />
    </StackPanel>
</UserControl>
