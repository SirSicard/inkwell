<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Appearance (the canvas's board 7): the mode, the dot presets (light and dark each keep
     their own), your colour and theirs in the mode shown (a picker, or the preset's), the edge glow,
     whether the ink moves, and what High Contrast does. Every change shows at once, everywhere. -->
<UserControl
    x:Class="Inkwell.Screens.AppearanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Each row: its label, then its control with the caption under it, at the 150 the other
             sections' labels take. A label beside a control that carries its own name is not read
             twice (Raw); Dots and the colours keep their Level 3 headings, in the eyebrow's type. -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InkBodyStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="RowEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource InkEyebrowStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="10">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Appearance" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource RowLabelStyle}" Text="Mode" />
            <RadioButtons
                x:Name="ModeChoice"
                Grid.Column="1"
                AutomationProperties.Name="Mode"
                MaxColumns="3"
                SelectionChanged="OnModeChosen">
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
                <x:String>Match system</x:String>
            </RadioButtons>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource RowEyebrowStyle}" Text="Dots" />
            <StackPanel Grid.Column="1" MaxWidth="560" HorizontalAlignment="Left" Spacing="6">
                <Grid x:Name="Presets" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="DotsNote" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ColoursHeading" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource RowEyebrowStyle}" />
            <StackPanel Grid.Column="1" MaxWidth="560" HorizontalAlignment="Left" Spacing="6">
                <StackPanel x:Name="ColourRows" Spacing="8" />
                <TextBlock
                    Style="{StaticResource InkCaptionStyle}"
                    Text="The orb's lighter shade follows. A colour too dark for night or too pale for day is adjusted so it stays visible." />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Glow the window's edge" />
            <StackPanel Grid.Column="1" Spacing="4">
                <ToggleSwitch
                    x:Name="EdgeSwitch"
                    MinWidth="0"
                    AutomationProperties.Name="Glow the window's edge"
                    OffContent=""
                    OnContent=""
                    Toggled="OnEdgeToggled" />
                <TextBlock Style="{StaticResource InkCaptionStyle}" Text="While you dictate or a call records" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource RowLabelStyle}" Text="The ink moves" />
            <StackPanel Grid.Column="1" Spacing="6">
                <RadioButtons
                    x:Name="MotionChoice"
                    AutomationProperties.Name="The ink moves"
                    SelectionChanged="OnMotionChosen">
                    <x:String>Follow Windows' Animation effects</x:String>
                    <x:String>Always still</x:String>
                </RadioButtons>
                <TextBlock
                    MaxWidth="560"
                    HorizontalAlignment="Left"
                    Style="{StaticResource InkCaptionStyle}"
                    Text="High Contrast gives solid cards, no translucency and stronger borders, and dims the orb behind the text." />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="FailureLine" Style="{StaticResource InkAlertTextStyle}" />
    </StackPanel>
</UserControl>
