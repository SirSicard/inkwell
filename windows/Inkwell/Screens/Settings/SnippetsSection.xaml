<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Snippets: say a trigger, get the text. As the Mac's SnippetsSection: the failure (with
     Start over when the stored list can't be read), where the list came from, the rows, the add
     form, the rule. The user's words are plain text here, never links. Editing a row opens a
     dialog (the Mac edits in place). -->
<UserControl
    x:Class="Inkwell.Screens.SnippetsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Inkwell.Core.Screens"
    xmlns:local="using:Inkwell.Screens"
    Loaded="OnLoaded">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Snippets" />
            <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,2" Style="{StaticResource InkCaptionStyle}" Text="Say a trigger, get the text" />
        </StackPanel>
        <!-- The failure wraps beside Start over (a Grid: a horizontal panel would never wrap it). -->
        <Grid ColumnSpacing="10" Visibility="{x:Bind local:SettingsFormat.Shows(Model.Failure), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource InkAlertTextStyle}" Text="{x:Bind Model.Failure, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Click="OnStartOver"
                Content="{x:Bind local:SnippetsSection.StartOverTitle}"
                ToolTipService.ToolTip="{x:Bind local:SnippetsSection.StartOverHelp}"
                AutomationProperties.HelpText="{x:Bind local:SnippetsSection.StartOverHelp}"
                Visibility="{x:Bind Model.Unreadable, Mode=OneWay}" />
        </Grid>
        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind local:SnippetsSection.FromImportText}" Visibility="{x:Bind Model.FromImport, Mode=OneWay}" />
        <TextBlock x:Name="Empty" Style="{StaticResource InkCaptionStyle}" Text="{x:Bind local:SnippetsSection.EmptyText}" />
        <ContentControl x:Name="RowsHost" HorizontalContentAlignment="Stretch" IsTabStop="False">
            <ItemsRepeater x:Name="Rows">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="core:SnippetDraft">
                        <Grid
                            Padding="0,8"
                            BorderBrush="{ThemeResource InkSeparatorBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="12"
                            Tag="{x:Bind Id}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="{StaticResource InkMonoFontFamily}"
                                FontWeight="SemiBold"
                                Opacity="{x:Bind local:SettingsFormat.Dimmed(Enabled)}"
                                Style="{StaticResource InkBodyStyle}"
                                Text="{x:Bind Trigger}" />
                            <StackPanel Grid.Column="1" Spacing="4" Opacity="{x:Bind local:SettingsFormat.Dimmed(Enabled)}">
                                <TextBlock MaxLines="3" Style="{StaticResource InkBodyStyle}" Text="{x:Bind Expansion}" TextTrimming="CharacterEllipsis" />
                                <Border
                                    HorizontalAlignment="Left"
                                    Padding="8,2"
                                    Background="{ThemeResource InkChipBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind local:SettingsFormat.Shows(Category)}">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource InkTextBrush}" Text="{x:Bind Category}" />
                                </Border>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="Toggle"
                                Grid.Column="2"
                                MinWidth="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Bind local:SettingsFormat.SnippetName(Trigger, Expansion, Category, Enabled)}"
                                IsOn="{x:Bind Enabled}"
                                OffContent=""
                                OnContent=""
                                Toggled="OnToggled" />
                            <Button x:Name="Edit" Grid.Column="3" VerticalAlignment="Top" Click="OnEdit" Content="Edit" />
                            <Button x:Name="Delete" Grid.Column="4" VerticalAlignment="Top" Click="OnDelete" Content="Delete" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ContentControl>
        <!-- The add form. Nothing is added to a list that has not been read (the model refuses too). -->
        <ContentControl x:Name="AddHost" Margin="0,4,0,0" HorizontalContentAlignment="Stretch" IsTabStop="False">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTrigger" AutomationProperties.Name="Trigger" PlaceholderText="Trigger" TextChanged="OnNewTriggerChanged" />
                <TextBox
                    x:Name="NewExpansion"
                    Grid.Column="1"
                    MaxHeight="120"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Text it becomes"
                    PlaceholderText="Text it becomes"
                    TextWrapping="Wrap" />
                <TextBox x:Name="NewCategory" Grid.Column="2" AutomationProperties.Name="Category" PlaceholderText="Category" />
                <Button x:Name="Add" Grid.Column="3" VerticalAlignment="Top" AutomationProperties.Name="Add a snippet" Click="OnAdd" Content="Add" IsEnabled="False" />
            </Grid>
        </ContentControl>
        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind local:SnippetsSection.HelpText}" />
    </StackPanel>
</UserControl>
