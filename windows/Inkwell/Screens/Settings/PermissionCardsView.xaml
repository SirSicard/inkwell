<?xml version="1.0" encoding="utf-8"?>
<!-- The four permission cards in one frame (Settings > Permissions and the first-run sheet). -->
<UserControl
    x:Class="Inkwell.Screens.PermissionCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="0" Style="{StaticResource InkCardStyle}">
        <StackPanel x:Name="Rows" />
    </Border>
</UserControl>
