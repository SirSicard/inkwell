<?xml version="1.0" encoding="utf-8"?>
<!-- What became of Inkwell 0.2's dictation key, said once until "Got it". The Mac shows it in
     Settings > Voice, under the keys. Nothing shows when there is nothing to say. -->
<UserControl
    x:Class="Inkwell.Screens.ImportKeyNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Border x:Name="Card" Style="{StaticResource InkCardStyle}" Padding="12" Visibility="Collapsed">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource InkSecondaryTextBrush}"
                Glyph="&#xE946;" />
            <TextBlock x:Name="Note" Grid.Column="1" Style="{StaticResource InkCaptionStyle}" Foreground="{ThemeResource InkTextBrush}" />
            <Button Grid.Column="2" VerticalAlignment="Top" Click="OnGotIt" Content="Got it" />
        </Grid>
    </Border>
</UserControl>
