<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Permissions: its heading and the four cards. -->
<UserControl
    x:Class="Inkwell.Screens.PermissionsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Permissions" />
        <ContentPresenter x:Name="CardsHost" />
    </StackPanel>
</UserControl>
