<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > About (the Mac's AboutSection): the version (updates are in General), the terms for Microsoft's
     components, the model credits, every component's notice, and the Rust crates under one
     disclosure. Each notice is an expander opening onto its
     full text, selectable; the Rust list scrolls in its own bounded, virtualized view, so an open
     list does not stretch the Settings page by a hundred rows. -->
<UserControl
    x:Class="Inkwell.Screens.AboutSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Inkwell.Core.Screens">
    <UserControl.Resources>
        <!-- A notice's text: Cascadia Mono at caption size, selectable, in its own scroll. -->
        <Style x:Key="NoticeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InkMonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Foreground" Value="{ThemeResource InkTextBrush}" />
        </Style>
        <Style x:Key="NoticeTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource InkBodyStyle}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="About" />
        <TextBlock Style="{StaticResource InkBodyStyle}" FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{x:Bind About.VersionLine}" />
        <!-- Inkwell's copyright notice, which the Windows SDK's licence asks an app shipping its code to display. -->
        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource InkCaptionStyle}" Text="{x:Bind core:AboutModel.CopyrightLine}" />

        <!-- The end-user terms Microsoft's licences require, for the Windows App SDK, the Windows
             SDK's .NET projection and the Visual C++ runtime (Notices.WindowsAppSdkTerms). -->
        <TextBlock Margin="0,8,0,0" AutomationProperties.HeadingLevel="Level3" AutomationProperties.Name="Terms" Style="{StaticResource InkEyebrowStyle}" Text="Terms" />
        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource InkBodyStyle}" Text="{x:Bind core:AboutModel.Terms}" TextWrapping="Wrap" />

        <TextBlock Margin="0,8,0,0" AutomationProperties.HeadingLevel="Level3" AutomationProperties.Name="Models" Style="{StaticResource InkEyebrowStyle}" Text="Models" />
        <StackPanel x:Name="ModelRows" Spacing="8" />

        <TextBlock Margin="0,8,0,0" AutomationProperties.HeadingLevel="Level3" AutomationProperties.Name="Code that ships inside Inkwell" Style="{StaticResource InkEyebrowStyle}" Text="Code that ships inside Inkwell" />
        <StackPanel x:Name="ComponentRows" Spacing="8" />

        <Expander
            x:Name="RustLibraries"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.HelpText="{x:Bind core:AboutModel.RustCaption}"
            AutomationProperties.Name="{x:Bind About.RustHeading}">
            <Expander.Header>
                <StackPanel Padding="0,6" Spacing="1">
                    <TextBlock Style="{StaticResource NoticeTitleStyle}" Text="{x:Bind About.RustHeading}" />
                    <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind core:AboutModel.RustCaption}" />
                </StackPanel>
            </Expander.Header>
            <!-- Virtualized: the crates' rows are built as they scroll into view. -->
            <ListView
                x:Name="RustList"
                MaxHeight="420"
                AutomationProperties.Name="{x:Bind About.RustHeading}"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind About.RustRows}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:NoticeRow">
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.HelpText="{x:Bind Detail}"
                            AutomationProperties.Name="{x:Bind Title}">
                            <Expander.Header>
                                <StackPanel Padding="0,6" Spacing="1">
                                    <TextBlock Style="{StaticResource NoticeTitleStyle}" Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind Detail}" />
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="220">
                                <TextBlock Style="{StaticResource NoticeTextStyle}" Text="{x:Bind Text}" />
                            </ScrollViewer>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>
    </StackPanel>
</UserControl>
