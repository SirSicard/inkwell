<?xml version="1.0" encoding="utf-8"?>
<!-- The catalogue's models where they can be downloaded (Settings > Models): each model's line,
     where it would come from, its download's progress, a failure in words with Retry, and a
     Download of its own; Cancel while it downloads, and Remove once it is in. The first run offers choices instead (ModelChoices). -->
<UserControl
    x:Class="Inkwell.Screens.ModelRowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens">
    <ItemsRepeater x:Name="Rows">
        <ItemsRepeater.Layout>
            <StackLayout Spacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:ModelRowItem">
                <!-- The model's lines and its button; the button under them at the narrowest. -->
                <local:LineOrStackPanel Fill="0" FillMinimum="160" Tag="{x:Bind Id}">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind Text}" />
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind From}" Visibility="{x:Bind local:SettingsFormat.Shows(From)}" />
                        <ProgressBar
                            AutomationProperties.Name="{x:Bind ProgressName}"
                            Maximum="1"
                            Visibility="{x:Bind Downloading}"
                            Value="{x:Bind Progress}" />
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind Status}" Visibility="{x:Bind local:SettingsFormat.Shows(Status)}" />
                        <TextBlock Style="{StaticResource InkAlertTextStyle}" Text="{x:Bind Failure}" Visibility="{x:Bind local:SettingsFormat.Shows(Failure)}" />
                        <TextBlock Style="{StaticResource InkAlertTextStyle}" Text="{x:Bind Note}" Visibility="{x:Bind local:SettingsFormat.Shows(Note)}" />
                    </StackPanel>
                    <!-- One of these at a time: Download or Retry while it is not in, Cancel while it
                         downloads or waits, Remove once it is installed (asks first). -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="6">
                        <Button
                            x:Name="Download"
                            AutomationProperties.Name="{x:Bind DownloadName}"
                            Click="OnDownload"
                            Content="Download"
                            Visibility="{x:Bind ShowsDownload}" />
                        <Button
                            x:Name="Retry"
                            AutomationProperties.Name="{x:Bind RetryName}"
                            Click="OnRetry"
                            Content="Retry"
                            Visibility="{x:Bind CanRetry}" />
                        <Button
                            x:Name="Cancel"
                            AutomationProperties.Name="{x:Bind CancelName}"
                            Click="OnCancel"
                            Content="Cancel"
                            Visibility="{x:Bind ShowsCancel}" />
                        <Button
                            x:Name="Remove"
                            AutomationProperties.Name="{x:Bind RemoveName}"
                            Click="OnRemove"
                            Content="Remove…"
                            Visibility="{x:Bind ShowsRemove}" />
                    </StackPanel>
                </local:LineOrStackPanel>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
