<?xml version="1.0" encoding="utf-8"?>
<!-- The catalogue's models where they can be downloaded (Settings > Models and the first-run
     sheet): each model's line, where it would come from, its download's progress, and a failure in
     words with Retry. Settings gives each row its own Download; the first run has one for all. -->
<UserControl
    x:Class="Inkwell.Screens.ModelRowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens">
    <ItemsRepeater x:Name="Rows">
        <ItemsRepeater.Layout>
            <StackLayout Spacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:ModelRowItem">
                <Grid ColumnSpacing="12" Tag="{x:Bind Id}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind Text}" />
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind From}" Visibility="{x:Bind local:SettingsFormat.Shows(From)}" />
                        <ProgressBar
                            AutomationProperties.Name="{x:Bind ProgressName}"
                            Maximum="1"
                            Visibility="{x:Bind Downloading}"
                            Value="{x:Bind Progress}" />
                        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="{x:Bind Status}" Visibility="{x:Bind local:SettingsFormat.Shows(Status)}" />
                        <TextBlock Style="{StaticResource InkAlertTextStyle}" Text="{x:Bind Failure}" Visibility="{x:Bind local:SettingsFormat.Shows(Failure)}" />
                    </StackPanel>
                    <Button
                        x:Name="Download"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind DownloadName}"
                        Click="OnDownload"
                        Content="Download"
                        Visibility="{x:Bind ShowsDownload}" />
                    <Button
                        x:Name="Retry"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind RetryName}"
                        Click="OnRetry"
                        Content="Retry"
                        Visibility="{x:Bind CanRetry}" />
                </Grid>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
