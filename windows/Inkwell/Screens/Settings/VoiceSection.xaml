<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Dictation (the canvas's Voice section, renamed; the Mac's VoiceSection): dictation on
     or off, the dictation key, the voice-edit key, what dictation says about itself and its
     failures, and the note about Inkwell 0.2's key. -->
<UserControl
    x:Class="Inkwell.Screens.VoiceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Each row: its label, then its controls with the caption under them (as Meetings and AI). -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InkBodyStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource InkCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InkBorderBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="10">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Dictation" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Dictation" />
            <StackPanel Grid.Column="1" Spacing="4">
                <ToggleSwitch
                    x:Name="DictationSwitch"
                    AutomationProperties.Name="Dictation"
                    OffContent=""
                    OnContent=""
                    Toggled="OnDictationToggled" />
                <TextBlock x:Name="SwitchCaption" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>
        </Grid>

        <!-- A key's row: the key, Record, the key as a cap, and how it is used beside it; what the
             key's check said under them. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Dictate" />
            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="KeyBox" MinWidth="170" AutomationProperties.Name="Dictate" SelectionChanged="OnKeyChosen" />
                    <!-- Any key: the next press, checked by the core (ShortcutRecorderModel). -->
                    <Button x:Name="RecordKeyButton" Click="OnRecordKey" />
                    <Border AutomationProperties.AccessibilityView="Raw" Style="{StaticResource KeyCapStyle}">
                        <TextBlock x:Name="KeyCap" FontFamily="{StaticResource InkMonoFontFamily}" FontSize="12" Foreground="{ThemeResource InkTextBrush}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource InkCaptionStyle}" Text="hold, speak, let go" />
                </StackPanel>
                <TextBlock x:Name="KeyMessage" TextWrapping="Wrap" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Edit a selection" />
            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="EditKeyBox" MinWidth="170" AutomationProperties.Name="Edit a selection" SelectionChanged="OnEditKeyChosen" />
                    <Button x:Name="RecordEditButton" Click="OnRecordEdit" />
                    <Border x:Name="EditKeyCapBorder" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource KeyCapStyle}">
                        <TextBlock x:Name="EditKeyCap" FontFamily="{StaticResource InkMonoFontFamily}" FontSize="12" Foreground="{ThemeResource InkTextBrush}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource InkCaptionStyle}" Text="select text, hold, say what to change" />
                </StackPanel>
                <TextBlock x:Name="EditMessage" TextWrapping="Wrap" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock x:Name="StatusText" Style="{StaticResource InkCaptionStyle}" />
            <Button x:Name="RetryButton" Click="OnRetry" />
            <TextBlock x:Name="EditKeyProblemText" Style="{StaticResource InkAlertTextStyle}" />
            <TextBlock x:Name="EditConsentProblemText" Style="{StaticResource InkAlertTextStyle}" />
            <TextBlock x:Name="SettingsProblemText" Style="{StaticResource InkAlertTextStyle}" />
        </StackPanel>

        <!-- The note about Inkwell 0.2's dictation key (another part's view), if the screen passes one. -->
        <ContentPresenter x:Name="ImportNoteHost" />

        <TextBlock
            Style="{StaticResource InkCaptionStyle}"
            Text="Editing sends the selection and what you say to a language model, and replaces the selection with the answer, so choosing its key asks you first where that is. Edits are not saved in the Library." />
    </StackPanel>
</UserControl>
