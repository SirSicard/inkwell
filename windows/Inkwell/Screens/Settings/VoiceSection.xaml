<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Dictation (the canvas's Voice section, renamed; the Mac's VoiceSection): dictation on
     or off, the dictation key, what dictation says about itself and its
     failures, and the note about Inkwell 0.2's key. -->
<UserControl
    x:Class="Inkwell.Screens.VoiceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens">
    <UserControl.Resources>
        <!-- Each row: its label, then its controls with the caption under them (as Meetings and AI). -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InkBodyStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource InkCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InkBorderBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="14">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="Dictation" />

        <local:SettingColumnsPanel>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Dictation" />
            <StackPanel Spacing="4">
                <ToggleSwitch
                    x:Name="DictationSwitch"
                    MinWidth="0"
                    AutomationProperties.Name="Dictation"
                    OffContent=""
                    OnContent=""
                    Toggled="OnDictationToggled" />
                <TextBlock x:Name="SwitchCaption" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>
        </local:SettingColumnsPanel>

        <!-- A key's row: the key, Record and the key as a cap, wrapping between them where the card
             is narrow; how the key is used, then what its check said, under them. The cap sits in a
             row-high cell so it centres on the controls' line. -->
        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel>
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Dictate" />
                <StackPanel Spacing="4">
                    <local:WrapPanel RowSpacing="8" Spacing="12">
                        <ComboBox x:Name="KeyBox" MinWidth="170" AutomationProperties.Name="Dictate" SelectionChanged="OnKeyChosen" />
                        <!-- Any key: the next press, checked by the core (ShortcutRecorderModel). -->
                        <Button x:Name="RecordKeyButton" Click="OnRecordKey" />
                        <Grid Height="32">
                            <Border AutomationProperties.AccessibilityView="Raw" Style="{StaticResource KeyCapStyle}">
                                <TextBlock x:Name="KeyCap" FontFamily="{StaticResource InkMonoFontFamily}" FontSize="12" Foreground="{ThemeResource InkTextBrush}" />
                            </Border>
                        </Grid>
                    </local:WrapPanel>
                    <TextBlock Style="{StaticResource InkCaptionStyle}" Text="hold, speak, let go" />
                    <TextBlock x:Name="KeyMessage" TextWrapping="Wrap" Style="{StaticResource InkCaptionStyle}" />
                </StackPanel>
            </local:SettingColumnsPanel>
        </Border>

        <TextBlock Style="{StaticResource InkCaptionStyle}" Text="Voice editing has its own shortcut in AI > Voice edit." />

        <StackPanel Spacing="4">
            <TextBlock x:Name="StatusText" Style="{StaticResource InkCaptionStyle}" />
            <Button x:Name="RetryButton" Click="OnRetry" />
            <TextBlock x:Name="SettingsProblemText" Style="{StaticResource InkAlertTextStyle}" />
        </StackPanel>

        <!-- The note about Inkwell 0.2's dictation key (another part's view), if the screen passes one. -->
        <ContentPresenter x:Name="ImportNoteHost" />

    </StackPanel>
</UserControl>
