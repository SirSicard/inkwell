<?xml version="1.0" encoding="utf-8"?>
<!-- Inkwell 0.2's history (the Mac's Import02Card): where it stands in words, Import while there is
     something to import, and why an import failed. On the first run's step, and in Settings > General
     as a card, while there is something to say. -->
<UserControl
    x:Class="Inkwell.Screens.Import02Card"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Frame">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LineText" Style="{StaticResource InkBodyStyle}" />
                <Button x:Name="ImportButton" Grid.Column="1" VerticalAlignment="Top" Click="OnImport" />
            </Grid>
            <TextBlock x:Name="FailureText" Style="{StaticResource InkAlertTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
