<?xml version="1.0" encoding="utf-8"?>
<!-- The first-run sheet (the Mac's OnboardingView), as a ContentDialog over the window: where the
     user is (dots, never a bar that fills), one of six steps (seven while Inkwell 0.2's history is
     offered), and Skip / Back / Continue (Start on the last, Not now on the import step). Its own
     buttons, in the Mac's order, rather than the dialog's. Polish's consent step shows inside the
     sheet (WinUI shows one dialog at a time). Welcome has the orb as its hero, playing a short
     demo (dictating, then a call); Appearance the mode and the dots; Ready a place to try it,
     where the orb answers the voice. -->
<ContentDialog
    x:Class="Inkwell.Screens.OnboardingSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell"
    Closed="OnClosed"
    Closing="OnClosing">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <!-- One fill under the sheet's content, the dialog's own (no translucent layer over it): the
             orbs paint it as their backdrop, since a SwapChainPanel hides what is under it. -->
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
    </ContentDialog.Resources>
    <Grid Width="620" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="Dot0" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot1" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot2" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot3" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot4" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot5" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
            <Ellipse x:Name="Dot6" Width="7" Height="7" AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource InkTextBrush}" />
        </StackPanel>

        <!-- The steps scroll when the window is too short for them, the dots and buttons staying put;
             the right padding keeps the step's buttons and lines clear of the scroll bar. The
             height a step keeps (so the sheet doesn't jump between steps) is inside it, so the
             sheet itself can shrink to the window. -->
        <ScrollViewer x:Name="StepScroller" Grid.Row="1" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="375">
            <StackPanel x:Name="WelcomeStep" Spacing="14">
                <!-- The orb as the hero: a short demo, dictating then a call. Decorative. -->
                <local:InkPanel
                    x:Name="WelcomeOrb"
                    Height="190"
                    AutomationProperties.AccessibilityView="Raw"
                    Backdrop="{ThemeResource ContentDialogBackground}"
                    IsHitTestVisible="False" />
                <!-- The same scale as every other step's title. -->
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" Text="Inkwell" />
                <TextBlock x:Name="WelcomeLine0" Style="{StaticResource InkReadingStyle}" />
                <TextBlock x:Name="WelcomeLine1" Style="{StaticResource InkReadingStyle}" />
                <TextBlock x:Name="WelcomeLine2" Foreground="{ThemeResource InkSecondaryTextBrush}" Style="{StaticResource InkReadingStyle}" />
            </StackPanel>

            <StackPanel x:Name="PermissionsStep" Spacing="12">
                <TextBlock x:Name="PermissionsTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <TextBlock x:Name="PermissionsNote" Style="{StaticResource InkCaptionStyle}" />
                <ContentPresenter x:Name="CardsHost" />
            </StackPanel>

            <!-- What Inkwell should be able to do, as choices (ModelChoices): the first always, the
                 others when ticked, each with the models it takes in a small line. Download carries
                 the total; nothing downloads before it, and Continue never waits for it. -->
            <StackPanel x:Name="ModelsStep" Spacing="12">
                <TextBlock x:Name="ModelsTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <TextBlock x:Name="ModelsNote" Style="{StaticResource InkBodyStyle}" />
                <StackPanel x:Name="ChoiceList" Spacing="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DownloadButton" Click="OnDownload" Style="{StaticResource InkAccentButtonStyle}" />
                    <Button x:Name="ModelsTryAgain" Click="OnModelsTryAgain" />
                </StackPanel>
                <TextBlock x:Name="DownloadLine" Style="{StaticResource InkCaptionStyle}" />
                <TextBlock x:Name="ModelsGoOn" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>

            <!-- Only while Inkwell 0.2's data is offered: its counts in words and Import; after an
                 import, what became of its dictation key. -->
            <StackPanel x:Name="ImportStep" Spacing="12">
                <TextBlock x:Name="ImportTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <ContentPresenter x:Name="ImportCardHost" />
                <ContentPresenter x:Name="ImportNoteHost" />
            </StackPanel>

            <!-- Light, dark or the system's, and the dots; Settings > Appearance has the rest. -->
            <StackPanel x:Name="AppearanceStep" Spacing="12">
                <TextBlock x:Name="AppearanceTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <RadioButtons
                    x:Name="ModeChoice"
                    AutomationProperties.Name="Mode"
                    MaxColumns="3"
                    SelectionChanged="OnModeChosen">
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                    <x:String>Match system</x:String>
                </RadioButtons>
                <StackPanel x:Name="PresetRow" Orientation="Horizontal" Spacing="8" />
                <TextBlock x:Name="AppearanceNote" Style="{StaticResource InkCaptionStyle}" />
            </StackPanel>

            <StackPanel x:Name="PolishStep" Spacing="12">
                <TextBlock x:Name="PolishTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <TextBlock x:Name="PolishNote" Style="{StaticResource InkBodyStyle}" />
                <ToggleSwitch
                    x:Name="PolishSwitch"
                    OffContent=""
                    OnContent=""
                    Toggled="OnPolishToggled" />
                <TextBlock x:Name="PolishStatus" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" />
                <!-- While this PC has no language model: Groq's free key, through Settings > AI's
                     flow (CloudModel.UseKey: pick, save the key, use). -->
                <!-- One choice: the line (its link inline), the key box under it with Save. -->
                <StackPanel x:Name="OwnKeyPanel" Spacing="8">
                    <TextBlock x:Name="OwnKeyLine" Style="{StaticResource InkBodyStyle}" TextWrapping="Wrap">
                        <Run x:Name="OwnKeyLead" /><Hyperlink x:Name="OwnKeyLink" />
                    </TextBlock>
                    <!-- A key already stored is the Windows account's: said, so it is no surprise. -->
                    <TextBlock x:Name="StoredKeyLine" Style="{StaticResource InkCaptionStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="OwnKeyBox" />
                        <Button x:Name="OwnKeyUse" Grid.Column="1" Click="OnOwnKeyUse" Style="{StaticResource InkAccentButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="OwnKeyNote" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock x:Name="OwnKeyStatus" Style="{StaticResource InkAlertTextStyle}" />
                </StackPanel>
                <!-- Polish's consent step, inside the sheet. Only its agreeing button sends anything. -->
                <Border x:Name="ConsentCard" Style="{StaticResource InkCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConsentTitle" AutomationProperties.HeadingLevel="Level2" FontWeight="SemiBold" Style="{StaticResource InkBodyStyle}" />
                        <TextBlock x:Name="ConsentMessage" Style="{StaticResource InkBodyStyle}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConsentCancel" Click="OnConsentCancel" Content="Cancel" />
                            <Button x:Name="ConsentAllow" Click="OnConsentAllow" Style="{StaticResource InkAccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ReadyStep" Spacing="14">
                <TextBlock x:Name="ReadyTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkHeadingStyle}" />
                <TextBlock x:Name="ReadyLine" Style="{StaticResource InkReadingStyle}" />
                <!-- With no speech model: Today's one action, or that the download runs. -->
                <Button x:Name="ReadyDownload" Click="OnReadyDownload" Style="{StaticResource InkAccentButtonStyle}" />
                <TextBlock x:Name="ReadyDownloading" Style="{StaticResource InkCaptionStyle}" />
                <!-- Try it: the orb answers the voice, and the words land in the box. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:InkPanel
                        x:Name="ReadyOrb"
                        Height="120"
                        AutomationProperties.AccessibilityView="Raw"
                        Backdrop="{ThemeResource ContentDialogBackground}"
                        IsHitTestVisible="False" />
                    <TextBox
                        x:Name="TryIt"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Try dictating here"
                        MinHeight="80"
                        TextWrapping="Wrap" />
                </Grid>
                <TextBlock x:Name="StillOffLine" Foreground="{ThemeResource InkAlertBrush}" Style="{StaticResource InkReadingStyle}" />
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Click="OnSkip" Content="Skip" />
            <Button x:Name="BackButton" Grid.Column="2" Click="OnBack" Content="Back" />
            <Button x:Name="NextButton" Grid.Column="3" Click="OnNext" Style="{StaticResource InkAccentButtonStyle}" />
        </Grid>
    </Grid>
</ContentDialog>
