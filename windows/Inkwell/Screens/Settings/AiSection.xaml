<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > AI (the Mac's AISection): first the language model (Windows only: this PC's own
     model, with its download, Use and Try it; or an own-key provider, its key, its model, Use and
     Test), then the three features that send words to a
     language model, each a switch with its line under it (seal red for a failure or a pause), and
     what each sends. Turning one on shows its consent step; nothing is sent until the user agrees
     there. -->
<UserControl
    x:Class="Inkwell.Screens.AiSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inkwell.Screens">
    <UserControl.Resources>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InkBodyStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="14">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkHeadingStyle}" Text="AI" />

        <local:SettingColumnsPanel>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Language model" />
            <StackPanel Spacing="8">
                <!-- The provider, its key, its model, Use and Test (LanguageModelRows, shared with the first run). -->
                <ContentPresenter x:Name="LanguageModelHost" />
                <!-- What this PC has of its own (LocalLlmModel.Caption): it says "no language model of
                     its own" only while the core offers none. -->
                <TextBlock x:Name="LanguageModelCaption" Style="{StaticResource InkCaptionStyle}" />
                <!-- How to get a free Groq key (GroqKeyGuideView), closed at first. Settings only:
                     the first run has the guide over Groq's own rows. -->
                <Expander
                    x:Name="GroqGuideExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                </Expander>
            </StackPanel>
        </local:SettingColumnsPanel>
        <!-- Local only (llm.local_only): on, no model off this PC is called, whatever is chosen. -->
        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Local only" />
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="LocalOnlySwitch"
                        AutomationProperties.Name="Local only: nothing leaves this computer"
                        OffContent=""
                        OnContent=""
                        Toggled="OnLocalOnlyToggled" />
                    <TextBlock x:Name="LocalOnlyCaption" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" />
                </StackPanel>
            </local:SettingColumnsPanel>
        </Border>

        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Polish my words" />
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="PolishSwitch"
                        AutomationProperties.Name="Polish my words"
                        OffContent=""
                        OnContent=""
                        Toggled="OnPolishToggled" />
                    <TextBlock x:Name="PolishStatus" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource InkCaptionStyle}" Text="Polish tidies a dictation's wording before it is typed: it keeps what you meant and never adds anything. It sends what you dictate to a language model, so it stays off until you turn it on and agree to where that is." />
                </StackPanel>
            </local:SettingColumnsPanel>
        </Border>
        <!-- Where polish may send: one OK per destination (a mode may polish on a model of its own,
             Settings > Modes), each with Revoke beside it. -->
        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Polish may send to" />
                <StackPanel x:Name="PolishConsents" Margin="0,6,0,0" Spacing="8" />
            </local:SettingColumnsPanel>
        </Border>

        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Voice edit" />
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="EditSwitch"
                        AutomationProperties.Name="Voice edit"
                        OffContent=""
                        OnContent=""
                        Toggled="OnEditToggled" />
                    <TextBlock x:Name="EditStatus" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" />
                    <ContentPresenter x:Name="EditShortcutHost" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource InkCaptionStyle}" Text="Voice edit sends the text you select and what you say to a language model, and replaces the selection with the answer, so it stays off until you turn it on and agree to where that is. Choose its shortcut here." />
                </StackPanel>
            </local:SettingColumnsPanel>
        </Border>

        <Border Style="{StaticResource InkSettingRowStyle}">
            <local:SettingColumnsPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Summaries and Ask" />
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="MeetingsSwitch"
                        AutomationProperties.Name="Summaries and Ask"
                        OffContent=""
                        OnContent=""
                        Toggled="OnMeetingsToggled" />
                    <TextBlock x:Name="MeetingsStatus" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource InkCaptionStyle}" Text="A meeting's summary, what was promised in it, and Ask send its transcript to a language model, so they stay off until you turn them on and agree to where that is." />
                </StackPanel>
            </local:SettingColumnsPanel>
        </Border>
    </StackPanel>
</UserControl>
