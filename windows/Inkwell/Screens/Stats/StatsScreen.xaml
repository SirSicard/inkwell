<?xml version="1.0" encoding="utf-8"?>
<!-- Stats, as the Mac's StatsScreen: the user's dictation (words, speed against their own past, time
     saved with its assumption, the streak and a heatmap), their meetings (hours, talk time by side,
     the longest monologue, their questions), promises kept, and milestones. Glow's cards over the
     orb; every number has a Narrator name, and the heatmap one sentence. A new library says plainly
     what will appear; a count that could not be made says so, never zero. -->
<UserControl
    x:Class="Inkwell.Screens.StatsScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        x:Name="Scroller"
        Background="{ThemeResource InkSurfaceBrush}"
        SizeChanged="OnScrollerSized"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="Page"
            MaxWidth="956"
            Padding="48,34,48,28"
            HorizontalAlignment="Left"
            Spacing="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkScreenTitleStyle}" Text="Stats" />
                    <TextBlock Style="{StaticResource InkCaptionStyle}" Text="Counted on this PC from your library. Nothing leaves it." />
                </StackPanel>
                <Button
                    x:Name="ShareButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="Makes an image of the numbers you pick, to copy or save"
                    Click="OnShare"
                    Content="Share card…"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="StaleLine"
                Style="{StaticResource InkAlertTextStyle}"
                Text="Couldn't count again. These are the numbers from before."
                Visibility="Collapsed" />
            <StackPanel
                x:Name="FailedRow"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource InkAlertBrush}"
                    Style="{StaticResource InkBodyStyle}"
                    Text="Couldn't count your stats." />
                <Button Click="OnTryAgain" Content="Try again" />
            </StackPanel>
            <ProgressRing
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Counting your stats"
                Visibility="Collapsed" />
            <StackPanel x:Name="Cards" Spacing="18" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
