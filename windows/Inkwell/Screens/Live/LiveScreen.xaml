<?xml version="1.0" encoding="utf-8"?>
<!-- Live: the meeting being recorded, as the Mac's LiveScreen. Your notes on the left (a plain
     multi-line text box), what is being said on the right (the ledger: dry finals, wet partials),
     and Ask along the bottom with the far end's questions stacked above it. With no meeting, it
     says so and offers Record now.

     Nothing here ticks while idle: the header's clock redraws once a second only while this screen
     is loaded and shows a meeting that is still recording (LiveScreen.xaml.cs). -->
<UserControl
    x:Class="Inkwell.Screens.LiveScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Inkwell.Core.Screens"
    xmlns:local="using:Inkwell.Screens"
    KeyboardAcceleratorPlacementMode="Hidden">
    <UserControl.Resources>
        <!-- One ledger line: its clock, the speaker's dot, who, and the words (grey italic while wet). -->
        <DataTemplate x:Key="LedgerRow" x:DataType="core:LiveLine">
            <Grid Padding="0,7" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,3,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource InkTimestampStyle}"
                    Text="{x:Bind Clock}"
                    TextAlignment="Right" />
                <Ellipse
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Fill="{ThemeResource InkTextBrush}"
                    Opacity="{x:Bind local:LiveViews.DotOpacity(Wet)}"
                    Visibility="{x:Bind local:LiveViews.Visible(Mine)}" />
                <Ellipse
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Fill="{ThemeResource InkThemBrush}"
                    Opacity="{x:Bind local:LiveViews.DotOpacity(Wet)}"
                    Visibility="{x:Bind local:LiveViews.Collapsed(Mine)}" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InkTextBrush}"
                        Opacity="{x:Bind local:LiveViews.SpeakerOpacity(Wet)}"
                        Text="{x:Bind Speaker}"
                        Visibility="{x:Bind local:LiveViews.Visible(Mine)}" />
                    <TextBlock
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InkThemBrush}"
                        Opacity="{x:Bind local:LiveViews.SpeakerOpacity(Wet)}"
                        Text="{x:Bind Speaker}"
                        Visibility="{x:Bind local:LiveViews.Collapsed(Mine)}" />
                    <!-- Settled: the text colour, selectable. -->
                    <TextBlock
                        AutomationProperties.Name="{x:Bind AccessibilityText}"
                        FontFamily="{StaticResource InkReadingFontFamily}"
                        FontSize="15.5"
                        Foreground="{ThemeResource InkTextBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:LiveViews.Collapsed(Wet)}" />
                    <!-- Still settling: grey and italic, replaced by the next guess. -->
                    <TextBlock
                        AutomationProperties.Name="{x:Bind AccessibilityText}"
                        FontFamily="{StaticResource InkReadingFontFamily}"
                        FontSize="15.5"
                        FontStyle="Italic"
                        Foreground="{ThemeResource InkSecondaryTextBrush}"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:LiveViews.Visible(Wet)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource InkSurfaceBrush}">
        <!-- No meeting is being recorded. -->
        <StackPanel x:Name="Idle" Padding="32" Spacing="12">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource InkScreenTitleStyle}" Text="Live" />
            <TextBlock
                Foreground="{ThemeResource InkSecondaryTextBrush}"
                Style="{StaticResource InkBodyStyle}"
                Text="No meeting is being recorded." />
            <Button x:Name="RecordNowButton" Click="OnRecordNow" Content="Record now" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="RecordNowFailure" Style="{StaticResource InkAlertTextStyle}" Visibility="Collapsed" />
        </StackPanel>

        <!-- The meeting. -->
        <Grid x:Name="MeetingView" Padding="36,26,36,22" RowSpacing="18" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The header: name, status line, far end; Stop and the legend on the right. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock
                        x:Name="MeetingTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="27"
                        FontWeight="Medium"
                        Style="{StaticResource InkScreenTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                x:Name="RecordingDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Fill="{ThemeResource InkRecordingBrush}" />
                            <TextBlock x:Name="StatusLine" Style="{StaticResource InkTimestampStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="AppLine" Style="{StaticResource InkTimestampStyle}" />
                        <TextBlock x:Name="StartedLine" Style="{StaticResource InkTimestampStyle}" />
                        <TextBlock x:Name="MicLine" Style="{StaticResource InkTimestampStyle}" />
                        <StackPanel x:Name="SideWarnings" Orientation="Horizontal" Spacing="10" />
                    </StackPanel>
                    <TextBlock x:Name="FarEndLine" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock x:Name="FarEndAlert" Style="{StaticResource InkAlertTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                    <Button
                        x:Name="StopButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.HelpText="Stops recording; the final pass then writes the record"
                        Click="OnStop"
                        Content="Stop" />
                    <TextBlock x:Name="StopFailure" HorizontalAlignment="Right" Style="{StaticResource InkAlertTextStyle}" />
                    <!-- The legend, read as one sentence. -->
                    <ContentControl
                        AutomationProperties.Name="Your lines are in the text colour, the others' are sepia; grey lines are still settling."
                        IsTabStop="False">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel AutomationProperties.AccessibilityView="Raw" Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource InkTextBrush}" />
                                <TextBlock Style="{StaticResource InkTimestampStyle}" Text="you" />
                            </StackPanel>
                            <StackPanel AutomationProperties.AccessibilityView="Raw" Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource InkThemBrush}" />
                                <TextBlock Style="{StaticResource InkTimestampStyle}" Text="them" />
                            </StackPanel>
                            <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource InkTimestampStyle}" Text="grey = still settling" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>

            <!-- Notes | ledger, under a hairline. The minimum widths are LiveLayout's (code-behind). -->
            <Grid
                Grid.Row="1"
                Padding="0,14,0,0"
                BorderBrush="{ThemeResource InkBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NotesColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="LedgerColumn" Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="NotesArea" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkEyebrowStyle}" Text="YOUR NOTES" />
                    <TextBox
                        x:Name="NotesBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        AutomationProperties.HelpText="Type as you listen. Each line is saved with the moment you wrote it."
                        AutomationProperties.Name="Your notes"
                        FontFamily="{StaticResource InkReadingFontFamily}"
                        FontSize="17"
                        IsSpellCheckEnabled="False"
                        LostFocus="OnNotesLeft"
                        PlaceholderText="Type as you listen."
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="OnNotesSelectionChanged"
                        TextChanged="OnNotesChanged"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        MaxLines="3"
                        Style="{StaticResource InkCaptionStyle}"
                        Text="Each line is kept with the moment you wrote it. After the call your notes lead the record, filled in from what was said."
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    AutomationProperties.AccessibilityView="Raw"
                    Fill="{ThemeResource InkBorderBrush}" />
                <Grid x:Name="LedgerArea" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource InkEyebrowStyle}"
                        Text="WHAT&apos;S BEING SAID" />
                    <TextBlock
                        x:Name="WaitingLine"
                        Grid.Row="1"
                        Style="{StaticResource InkCaptionStyle}"
                        Text="Waiting for someone to speak." />
                    <ScrollViewer x:Name="LedgerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                x:Name="EarlierLine"
                                Margin="0,0,0,6"
                                Style="{StaticResource InkCaptionStyle}"
                                Text="Earlier lines are in the record." />
                            <ItemsRepeater x:Name="LedgerRows" ItemTemplate="{StaticResource LedgerRow}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Ask: the far end's questions (Ctrl+1 to Ctrl+4 answers one) and a field for anything else. -->
            <Border Grid.Row="2" Padding="14,12" Style="{StaticResource InkCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="StackArea" Spacing="6">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource InkEyebrowStyle}" Text="ASKED OF YOU" />
                        <StackPanel x:Name="StackButtons" Spacing="2" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="AskBox"
                            AutomationProperties.Name="Ask about this call"
                            KeyDown="OnAskKeyDown"
                            PlaceholderText="Ask about this call"
                            TextChanged="OnAskChanged" />
                        <Border
                            Grid.Column="1"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            BorderBrush="{ThemeResource InkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBlock Style="{StaticResource InkTimestampStyle}" Text="Ctrl+I" />
                        </Border>
                    </Grid>
                    <StackPanel x:Name="AskedList" Spacing="8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
