<?xml version="1.0" encoding="utf-8"?>
<!-- Today (the canvas's Glow Today, the Mac's TodayScreen): the hero over the orb (the date, the
     greeting, whether Inkwell listens and the dictation key, Record now), the live card while a
     meeting records or blots (Open, Stop, the final pass's progress), what needs the user, the last
     meeting, what is up next, what is owed soon, and today's and this week's counts at the foot.
     Every word comes from the models (Inkwell.Core/Screens/Today, Library, Live/OwedModel); the
     code-behind only places them. Two columns (1.3 : 1) from 624 px of content, else one. -->
<UserControl
    x:Class="Inkwell.Screens.TodayScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Page" Padding="36,20,36,28" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The hero, over the orb: the date, the greeting, the status line; Record now. -->
            <Grid MinHeight="250" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Padding="8,0,0,6" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock x:Name="DateLine" Style="{StaticResource InkCaptionStyle}" />
                    <TextBlock
                        x:Name="Greeting"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource InkGreetingStyle}" />
                    <TextBlock x:Name="StatusLine" Style="{StaticResource InkCaptionStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Padding="0,0,8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="6">
                    <Button
                        x:Name="RecordNow"
                        Padding="22,13,22,14"
                        HorizontalAlignment="Right"
                        AutomationProperties.AcceleratorKey="Control+Shift+R"
                        AutomationProperties.Name="Record now"
                        Click="OnRecordNow"
                        FontWeight="SemiBold"
                        Style="{StaticResource InkAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                Width="9"
                                Height="9"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Fill="{ThemeResource InkRecordingBrush}" />
                            <TextBlock Text="Record now" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RecordNowFailure" HorizontalAlignment="Right" Style="{StaticResource InkAlertTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- The live card, while a meeting records or blots: Open (Live) and Stop. -->
            <Border
                x:Name="LiveCard"
                Grid.Row="1"
                Padding="20,16"
                AutomationProperties.Name="Live meeting"
                Style="{StaticResource InkCardStyle}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="LiveTitle"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Style="{StaticResource InkBodyStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock x:Name="LiveLine" AutomationProperties.LiveSetting="Polite" Style="{StaticResource InkCaptionStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Opens the meeting's live screen"
                        Click="OnOpenLive"
                        Content="Open" />
                    <Button
                        x:Name="LiveStop"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AcceleratorKey="Control+Period"
                        AutomationProperties.HelpText="Stops recording; the final pass then writes the record"
                        Click="OnStop"
                        Content="Stop"
                        Style="{StaticResource InkAccentButtonStyle}" />
                </Grid>
            </Border>

            <!-- Needs you: the first item, and the rest behind "N more". -->
            <Border
                x:Name="NeedsYouCard"
                Grid.Row="2"
                Padding="20,16"
                AutomationProperties.Name="Needs you"
                Background="{ThemeResource InkAlertCardBrush}"
                BorderBrush="{ThemeResource InkAlertChipBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource GlowCardCornerRadius}"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="NeedsYouRows" Spacing="10" />
                    <HyperlinkButton
                        x:Name="NeedsYouMore"
                        Margin="44,0,0,0"
                        Padding="0"
                        Click="OnNeedsYouMore"
                        FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Last meeting | Up next and Owed soon, each a card over the orb -->
            <Grid x:Name="Columns" Grid.Row="3" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="LastMeeting" VerticalAlignment="Top" Style="{StaticResource InkCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        AutomationProperties.Name="Last meeting"
                        Style="{StaticResource InkEyebrowStyle}"
                        Text="Last meeting" />
                    <HyperlinkButton
                        x:Name="LastMeetingTitleLink"
                        Padding="0"
                        AutomationProperties.HelpText="Opens the record"
                        Click="OnOpenLastMeeting">
                        <TextBlock
                            x:Name="LastMeetingTitle"
                            FontFamily="{StaticResource InkDisplayFontFamily}"
                            FontSize="28"
                            Foreground="{ThemeResource InkTextBrush}"
                            MaxLines="3"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </HyperlinkButton>
                    <TextBlock x:Name="LastMeetingLine" Style="{StaticResource InkTimestampStyle}" TextWrapping="Wrap" />
                    <!-- The summary's first paragraph; its headline is already the title above. -->
                    <TextBlock
                        x:Name="LastMeetingLede"
                        Margin="0,4,0,0"
                        IsTextSelectionEnabled="True"
                        LineHeight="26"
                        Style="{StaticResource InkReadingStyle}" />
                    <StackPanel x:Name="LastMeetingButtons" Margin="0,6,0,0" Orientation="Horizontal" Spacing="10">
                        <Button Click="OnOpenLastMeeting" Content="Open record" />
                        <Button x:Name="PlayButton" Click="OnPlayLastMeeting">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE768;" />
                                <TextBlock x:Name="PlayText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="LastMeetingNote" Style="{StaticResource InkReadingStyle}" Foreground="{ThemeResource InkSecondaryTextBrush}" />
                    <HyperlinkButton
                        x:Name="LastMeetingRetry"
                        Padding="0"
                        Click="OnRetryToday"
                        Content="Try again" />
                </StackPanel>
                </Border>

                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="18">
                    <!-- Up next -->
                    <Border Style="{StaticResource InkCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            AutomationProperties.Name="Up next"
                            Style="{StaticResource InkEyebrowStyle}"
                            Text="Up next" />
                        <TextBlock x:Name="EventTitle" FontSize="16" FontWeight="SemiBold" Style="{StaticResource InkBodyStyle}" />
                        <TextBlock x:Name="EventLine" Style="{StaticResource InkTimestampStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="EventRecords" Style="{StaticResource InkCaptionStyle}" />
                        <TextBlock x:Name="UpNextNote" Style="{StaticResource InkCaptionStyle}" />
                        <Button
                            x:Name="ConnectButton"
                            AutomationProperties.HelpText="Asks for access to your calendars"
                            Click="OnConnect" />
                    </StackPanel>
                    </Border>

                    <!-- Owed soon -->
                    <Border Style="{StaticResource InkCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                AutomationProperties.Name="Owed soon"
                                Style="{StaticResource InkEyebrowStyle}"
                                Text="Owed soon" />
                            <HyperlinkButton
                                x:Name="OwedAll"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="OnOpenOwed"
                                FontSize="13" />
                        </Grid>
                        <TextBlock x:Name="OwedNote" Style="{StaticResource InkCaptionStyle}" />
                        <StackPanel x:Name="OwedRows" Spacing="12" />
                    </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- The counts: side by side when they fit, one under the other when not. -->
            <Border
                Grid.Row="5"
                Padding="0,16,0,0"
                BorderBrush="{ThemeResource InkBorderBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel x:Name="Stats" Orientation="Horizontal" Spacing="28" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
