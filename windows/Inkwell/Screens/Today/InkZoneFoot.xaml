<?xml version="1.0" encoding="utf-8"?>
<!-- The foot of Today's ink zone (the canvas's rail foot, the Mac's RecordControls): whether
     Inkwell listens for calls, which key dictates, and Record now. The ink zone is paper in both
     themes, so the foot keeps the light theme's colours. -->
<UserControl
    x:Class="Inkwell.Screens.InkZoneFoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock
                x:Name="ListeningLine"
                FontFamily="{StaticResource InkMonoFontFamily}"
                FontSize="11.5"
                Foreground="{ThemeResource InkTextBrush}" />
            <TextBlock
                x:Name="DictateLine"
                FontFamily="{StaticResource InkMonoFontFamily}"
                FontSize="11.5"
                Foreground="{ThemeResource InkSecondaryTextBrush}" />
        </StackPanel>
        <Button
            x:Name="RecordNow"
            Height="40"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Record now"
            Click="OnRecordNow"
            Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse
                    Width="8"
                    Height="8"
                    AutomationProperties.AccessibilityView="Raw"
                    Fill="{ThemeResource InkRecordingBrush}" />
                <TextBlock Text="Record now" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="RecordNowFailure" Style="{StaticResource InkAlertTextStyle}" />
    </StackPanel>
</UserControl>
