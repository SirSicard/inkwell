<Project>
  <!-- Every project in the Windows solution. -->
  <!-- The SDK is pinned in global.json (rollForward disable), as the Rust toolchain is in
       core/rust-toolchain.toml: packages.lock.json records packs versioned with the SDK, so another
       SDK fails the locked restore. Bump both in their own change. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Restores are pinned: packages.lock.json is checked in and CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- x64, and ARM64 when a project is built with -p:Platform=ARM64 (its project references
         inherit it). The solution cannot switch it: it refuses -r and passes its projects no
         platform, so ARM64 builds go project by project (win-arm64.yml). The platform target
         follows the runtime identifier. ARM64 is built, tested and published on an ARM64 machine,
         not cross-compiled from x64. Restore covers both runtime identifiers, so each
         packages.lock.json holds both. The core's DLL (InkCoreDir) must be built for the same
         architecture. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
  </PropertyGroup>

  <!-- The core's DLL (ink_ffi.dll, the cdylib of core/crates/ink-ffi): built in
       core/ (cargo build, package ink-ffi, its lib target), copied next to what runs it. Override InkCoreDir to
       use another build (a release one, say). -->
  <PropertyGroup>
    <InkCoreDir Condition="'$(InkCoreDir)' == ''">$(MSBuildThisFileDirectory)..\core\target\debug\</InkCoreDir>
  </PropertyGroup>
</Project>
