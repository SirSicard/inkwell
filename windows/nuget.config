<?xml version="1.0" encoding="utf-8"?>
<!-- One source: nuget.org. Every package the solution pulls is licence-checked by
     scripts/nuget-licences.ps1 (win.yml). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
