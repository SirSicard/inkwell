<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's entitlements, signed into the main executable by scripts/build-mac.sh. The app runs
  under the hardened runtime and is not sandboxed.

  audio-input: the hardened runtime blocks the microphone unless this is granted, and it blocks it
  silently (no prompt, the grant simply reads as denied). System audio capture (process taps) is
  not a hardened-runtime resource and needs no entitlement; its prompt text is in Info.plist.

  calendars: Today's "Up next" reads the next event with EventKit. Under the hardened runtime,
  calendar access is refused without this entitlement, whatever the user answers the prompt.

  Add an entitlement only with the feature that needs it, and say why here.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
