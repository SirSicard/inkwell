<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's Info.plist. scripts/build-mac.sh copies it into the bundle and sets the two version
  keys (INK_VERSION, INK_BUILD_NUMBER).
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>Inkwell</string>
  <key>CFBundleExecutable</key><string>Inkwell</string>
  <!-- The 0.2 app's identifier. Same identifier and same Developer ID team means the same
       designated requirement, so the microphone and Accessibility grants carry over. -->
  <key>CFBundleIdentifier</key><string>com.inkwell.app</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Inkwell</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>CFBundleVersion</key><string>0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <!-- A menu-bar app: no Dock icon until the main window opens (MainWindowController). -->
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <!-- The app's accent is Glow's button fill, never the system's blue: the selected row of a list,
       the default button, the selected segment, a switch that is on. Assets.xcassets holds it per
       mode (build-mac.sh compiles it; a test checks it against the tokens). macOS uses an app's
       accent while the user's is Multicolor, the default; the SwiftUI controls are also tinted
       with it (MainWindowController), which holds whatever the user's accent is. -->
  <key>NSAccentColorName</key><string>AccentColor</string>
  <!-- The app icon, "Halo rim": mac/AppIcon.icns, rendered by design/icon/make_icon.py and copied
       into Contents/Resources by build-mac.sh. -->
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <!-- The app's own NSApplication subclass (InkwellApplication: Quit ends a sheet or alert first).
       main() creates it; nothing reads this key today, it names the class the app really uses. -->
  <key>NSPrincipalClass</key><string>Inkwell.InkwellApplication</string>
  <!-- Never killed without a Quit: quitting stops the core, which unloads its models first
       (llama.cpp's Metal backend aborts the process at exit with a model still loaded). -->
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSSupportsSuddenTermination</key><false/>
  <!-- Shown verbatim in the permission prompts: what is captured, and that it stays here. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Inkwell records your voice while you dictate or take meeting notes. It is transcribed on this Mac, and the recording never leaves it.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Inkwell records the other side of your meetings from your meeting app, so both sides are transcribed on this Mac. The recording never leaves it.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Inkwell reads your calendar to show your next meeting, and to name each meeting and who was in it. Your calendar never leaves this Mac.</string>
  <!-- In-app updates (Sparkle 2): Sources/Inkwell/Updates.swift, docs/RELEASING.md. The feed is
       the appcast on the latest GitHub release. -->
  <key>SUFeedURL</key><string>https://github.com/SirSicard/inkwell/releases/latest/download/appcast.xml</string>
  <!-- The public half of the maintainer's EdDSA release key (32 bytes, base64). Empty until the
       key is generated: the app then starts no updater, and the release workflow refuses to
       publish. -->
  <key>SUPublicEDKey</key><string>2zqgoIMo0aYQidpdYGrCNpGY1WB5u4YE3ib2cG8RmJk=</string>
  <!-- An update's EdDSA signature is checked before its archive is unpacked, and the feed itself
       must be signed with the same key. -->
  <key>SUVerifyUpdateBeforeExtraction</key><true/>
  <key>SURequireSignedFeed</key><true/>
  <!-- A check sends nothing about this Mac. (Automatic checks are the user's choice: Sparkle asks
       before the first one.) -->
  <key>SUEnableSystemProfiling</key><false/>
</dict>
</plist>
